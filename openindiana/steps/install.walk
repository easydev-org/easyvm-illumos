# OPENINDIANA 2026.10 GUI ISO - ITS OWN GRAPHICAL INSTALLER, MEASURED CLICK BY CLICK.
#
# THIS REPLACES THE MINIMAL-ISO / TEXT-INSTALLER FLOW, FOR TWO REASONS THAT COMPOUND:
#
# 1  THE GUI ISO ALREADY CARRIES THE DESKTOP. MEASURED on the pod, 2026-11-26, on the live desktop:
#
#	$ ls /usr/share/xsessions/        mate.desktop  xterm.desktop
#	$ which mate-session lightdm      /usr/bin/mate-session   /usr/sbin/lightdm
#	$ pkg list -H | wc -l             1368
#
#    The minimal ISO (569 MiB) has none of it, so the old flow had to `pkg install mate_install`
#    from the network after installing - forty minutes when it worked, and the eight-hour sequence of
#    failures this repository's history records when it did not (the licence prompt, the boot-
#    environment restart, the scrolled exit line, the OCR that reads SESSION as SESSTON, and lightdm
#    sitting at `offline` because its greeter was never installed). The GUI ISO (2.47 GiB) needs NO
#    NETWORK: the installer copies 1368 packages off the medium.
#
# 2  THE GRAPHICAL INSTALLER IS SIX PAGES OF CLICKS, WHERE THE TEXT ONE WAS FORTY OF KEYSTROKES.
#
#    The text installer is driven by F2/F3 and the arrow keys, and every failure in this stage's
#    history came from that: a Return sent before the line was read, a `ret` that does not move
#    between fields, `spc` to tick a checkbox. The graphical one draws a Welcome/Disk/TimeZone/
#    Locale/Users/Installation/Finish wizard with a Next button in one place on every page and real
#    text fields, so a step is a `click_at` and a `type`, and there is no timing to lose.
#
# MEASURED END TO END on the pod, 2026-11-26: the wizard was driven through all six pages by clicks
# alone, the transfer wrote 11.2 GiB to the disk, and the resulting disk was converted out and booted
# with no medium attached, where it came up to lightdm's login screen. That last frame is the proof:
#
#	openindiana            (hostname, top bar)
#	[ username ]  [ Enter your password ]   Cancel    Log In
#
# THE WIZARD IS STARTED FROM A TERMINAL, NOT FROM A DESKTOP ICON. The desktop carries
# `install_openindiana.desktop` with `Exec=/usr/bin/sudo /usr/bin/gui-install`, and double-clicking it
# was MEASURED not to launch reliably (the icon selected, the wizard did not appear - two clicks 0.3s
# apart and two 1s apart both failed). The terminal is on the panel at a fixed place, and the command
# is short, so that is the path taken here.
#
# 1024x768 IS DELIBERATE. Every coordinate below was measured at this framebuffer.
walkthrough "openindiana 2026.10 gui - its live desktop, its graphical installer, an installed desktop"
resolution 1024x768
recording_resolution 1024x768
var disk_gb
  default "25"
  from args.disk_gb
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
# THE GUEST'S MEMORY IS DECLARED, BECAUSE THE INSTALLER IS THE HEAVIEST THING HERE.
#
# MEASURED on run 45806933916: the transfer reached only 24% and the machine restarted, and CI's own
# stage could not check the size at all because this file named none - it printed "the guest size is
# the engine's default". The GUI wizard copies 1368 packages and builds cpio lists in memory while
# the live MATE desktop is resident; 4 GiB is what the `-m 4096` in the boot args asks for, and
# saying it here lets `stage.yml` refuse a runner that cannot hold it instead of letting the guest be
# killed a few minutes in.
# memory_mb == 4096

step "the media this stage boots from is already on disk"
  needs [OI-hipster-gui-20261030.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size "{{ disk_gb }}"


step "boot the live desktop media"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=OI-hipster-gui-20261030.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800


# THE LOADER PRINTS ON THE SERIAL LINE, SO THIS WAIT NEEDS NO OCR: GRUB's menu, then "Loading unix...",
# then "Booting...". The live image unpacks to RAM before X comes up, which is why this waits on the
# console line and the screen read that follows it is generous.
step "the loader has handed over to the kernel"
  until "Loading unix"
  from console
  timeout 420


# THE LANGUAGE QUESTION, WHICH THE MINIMAL MEDIUM NEVER SHOWED. MEASURED: the list is
#
#	1, Chinese - Simplified   2, Chinese - Traditional   3, English   4, French   ...
#
# and the prompt itself says "default is 3", so a single Return takes English.
# THE ILLUMOS LOADER'S OWN MENU CAN HOLD THE BOOT, SO A RETURN IS SENT WITH EVERY LOOK.
#
# MEASURED on run 45835910098: the disk was freshly created (`disk.qcow2: 0 MiB`), the ISO was at
# `bootindex=0`, and the screen nevertheless sat on
#
#	Welcome to illumos   1. Boot Multi User [Enter]   2. Boot Single User   ...
#
# for the whole sixty-attempt budget. That menu belongs to the loader inside the ISO, and its autoboot
# does not always fire - the same medium on other runs went straight to `Preparing live image for
# use`. A Return takes its preselected first row (`Boot Multi User`), which is what boots the live
# system, and at the language prompt a Return is harmless because that prompt reads a NUMBER and an
# empty line is its documented default.
# THE LANGUAGE PAGE IS A RACE, AND THE DESKTOP IS THE WINNER - SO BOTH ARE ACCEPTED.
#
# MEASURED on the pod, run 4a0ff72: the loop below sent a Return every ten seconds to clear the ISO's
# loader menu, and that Return ALSO accepted the language page's default - so the page was gone in a
# blink and the loop then waited the rest of its budget for a list that would never come back, while
# the MATE desktop sat on screen. `Boot Multi User` and `English` are the same fork in the road: either
# the machine is still at the loader, or it is at the language list, or it is already on the desktop.
#
# SO THE GATE IS "THE LIVE IMAGE IS UP, IN ANY OF ITS THREE SHAPES", and the step after this one -
# which already waits for `Applications`/`Places`/`System` - is the one that confirms the desktop.
# THE LANGUAGE PAGE IS ANSWERED EXPLICITLY, BECAUSE A BARE RETURN DOES NOT ALWAYS TAKE.
#
# MEASURED on the pod: the loop below sent `ret` to clear the ISO's loader menu, and that Return got
# the machine as far as the language list - where it then SAT at
#
#	To select the language you wish to use, enter a number [default is 3]:
#
# while the walk had already moved on to waiting for the desktop. The prompt reads a NUMBER, and a
# page that is waiting for a number is not advanced by an empty Return on this console.
#
# SO `3` IS TYPED AND TAKEN, AND THE THREE SHAPES ARE STILL ALLOWED: the loader menu means "press
# Return", the language list means "type 3", and the desktop means "it is already up". The gate below
# accepts any of them and the next step waits for the desktop itself.
# EACH ROUND SENDS BOTH ANSWERS, AND EACH IS HARMLESS WHERE IT DOES NOT APPLY.
#
# MEASURED on the pod: the loader menu is cleared by a Return; the language list is NOT ("enter a
# number [default is 3]" sat there through a bare Return); and once the desktop is up, neither matters
# because the gate has already matched.
#
# SO EVERY ROUND TYPES `3` AND THEN A RETURN. On the loader menu the `3` selects `3. Escape to loader
# prompt`, which the following Return enters - and the next round's Return leaves. That is noisy but it
# is bounded, and the loop below stops the moment the desktop paints. The alternative - branching on
# which page is up - needs a `then`/`else` the step vocabulary does not have.
# THE LOADER MENU AND THE LANGUAGE LIST TAKE DIFFERENT ANSWERS, AND `when:` TELLS THEM APART.
#
# MEASURED on the pod, twice:
#
#	loader menu   `1. Boot Multi User [Enter]` - a Return takes row 1
#	language list `enter a number [default is 3]` - a Return does NOTHING here; `3` is required
#
# and typing `3` at the loader menu selects `3. Escape to loader prompt` instead, which put the kernel
# on a path that hung at `Booting...` with the serial line silent for ten minutes.
#
# SO TWO STEPS, EACH GATED ON ITS OWN PAGE BY `when:`. A step whose words are not on screen does not
# run at all, so the pair is a branch without needing `if`/`then`.
# THE LOADER MENU IS CLEARED FIRST, WITH RETURNS, UNTIL THE LANGUAGE LIST APPEARS.
#
# MEASURED on the pod, three times, each closing a different door:
#
#	`3` at the loader menu   selects `3. Escape to loader prompt`; the kernel then hangs at
#	                        `Booting...` with the serial line silent for ten minutes.
#	a bare Return at the language list   does nothing - `enter a number [default is 3]` waits
#	a `when: [Chinese]` guard   did not fire, because the frame the guard reads had not been
#	                        repainted since the page changed.
#
# SO THE TWO PAGES GET TWO STEPS: a loop that sends ONLY Returns while waiting for `Chinese` to
# appear, and then one explicit `3`+Return. Neither can misfire on the other's page.
step "wait for the language list, clearing the loader menu as it comes"
  repeat
    do
      item "read the screen"
        read
          name lang
      item "is the language list up"
        check
          source lang
          mode text
          name seen
          rect [0, 0, 1024, 768]
          rect_at [1024, 768]
          words [[Chinese], [Swedish]]
      item "press Return, which clears the loader menu and is ignored here"
        if seen
          then
            item
              settle 1
          else
            item
              input ret
              settle 8
    until
      seen
    max 40


step "type 3, which is English"
  input text "3"
  settle 3


step "take it"
  input ret
  settle 10


# THE MATE DESKTOP IS THE WITNESS THAT THE LIVE IMAGE IS UP. Its panel draws Applications, Places and
# System along the top, and the desktop carries the two install launchers.
step "the live mate desktop is on screen"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name desktop
    until
      bind up
      source desktop
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Applications], [Places], [System]]
    max 90


# THE INSTALLER IS STARTED THROUGH `Run Application`, AND THAT IS THE ONLY PATH THAT WAS STABLE.
#
# THREE OTHERS WERE MEASURED AND EACH FAILED FOR ITS OWN REASON:
#
#	the panel's terminal icon   its x position moves between boots - the panel carries Firefox,
#	                            Thunderbird and the terminal, and they were at 295 on one boot and 292
#	                            on the next, so a fixed coordinate misses about half the time.
#
#	double-clicking the desktop  THE DESKTOP'S ICONS ARE REORDERED ON EVERY BOOT. MEASURED across
#	launcher                     three boots: the column was Computer/Home/Live/Install/Trash/Text/
#	                            Drivers once, and Computer/Home/Live/Drivers/Install/Text the next.
#	                            A coordinate that lands on `Install OpenIndiana` on one boot lands
#	                            on `Device Driver Utility` on the next.
#
#	a terminal, then typing      works, but only after the same unreliable panel click.
#
# `Applications` IS AT A FIXED PLACE because the panel's left end never moves, and its LAST row,
# `Run Application...`, is a dialog with one text field and a Run button - all at fixed coordinates.
# MEASURED end to end: the wizard comes up on the first attempt, every time.
# ONE CLICK IS ENOUGH, AND A PAIR IS WHAT BROKE IT.
#
# MEASURED on the pod after watching both behaviours: a single click on `Applications` opens the menu
# at once. The first version of this step clicked twice per attempt, and that FAILED even though a
# pair sent by hand appeared to work - because `Click` in the driver does not just press the button,
# it MOVES the pointer first (it re-establishes the position at a corner, then at the target - see the
# note in qmp.go). A second click therefore starts by dragging the pointer OUT of the open menu, which
# closes it, and only then clicks `Applications` again - landing in an unpredictable open/shut state.
#
# THE WITNESS IS THE MENU'S OWN LAST ROW. `Run Application` appears nowhere else on this desktop, and
# the whole 1024x768 frame is read rather than a crop: MEASURED, tesseract on the full frame reads
# `Run Application` where a 400x380 crop at 3x read the same words with a trailing dot.
step "open the applications menu"
  repeat
    do
      item "click applications"
        input 40 12
        click_at [1024, 768]
        settle 5
      item "read the screen"
        read
          name menu
    until
      bind up
      source menu
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Run, Application]]
    max 12


# `Run Application...` IS THE MENU'S LAST ROW, at (55, 295). MEASURED: the rows are Accessories,
# Collection, Graphics, Internet, Office, Other, Programming, Sound & Video, System Tools, and then
# Run Application at the bottom.
step "choose run application"
  input 55 295
  click_at [1024, 768]
  settle 5


step "the run dialog is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name rundlg
    until
      bind up
      source rundlg
      mode text
      rect [200, 250, 850, 520]
      rect_at [1024, 768]
      scale 1
      words [[Run, Application], [Cancel], [Run]]
    max 20


# THE FIELD IS THE WIDE BOX UNDER THE GEARS ICON, at (500, 355) in the dialog measured above.
step "type the installer's path"
  input 500 355
  click_at [1024, 768]
  settle 2


step "the command"
  input text "sudo /usr/bin/gui-install"
  type_gap 0.06
  settle 3


# `Run` IS THE DIALOG'S LOWER-RIGHT BUTTON, at (645, 465). No `Run in terminal` is needed: the wizard
# is a GTK application of its own and draws regardless of whether it has a terminal.
step "run it"
  input 645 465
  click_at [1024, 768]
  settle 20


# PAGE 1 - WELCOME. The wizard's title bar reads "OpenIndiana Installer (as superuser)", the left rail
# lists Welcome / Disk / Time Zone / Locale / Users / Installation / Finish, and Next is the button at
# the lower right on EVERY page: (895, 708) at 1024x768.
step "the wizard's welcome page is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name welcome
    until
      bind up
      source welcome
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Welcome], [Next], [OpenIndiana]]
    max 60


step "next, past the welcome page"
  input 895 708
  click_at [1024, 768]
  settle 8


# PAGE 2 - DISK. It detects "25.0GB Unknown", proposes `Partition the disk` with a Solaris2 partition,
# and offers `Use the whole disk` as a radio above it. The radio for the whole disk is at (267, 297).
step "the disk page is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name diskpage
    until
      bind up
      source diskpage
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Where, should], [Disk]]
    max 40


step "use the whole disk"
  input 267 297
  click_at [1024, 768]
  settle 4


step "next, with the whole disk chosen"
  input 895 708
  click_at [1024, 768]
  settle 8


# PAGE 3 - TIME ZONE, DATE AND TIME. The region defaults to `GMT/UTC` and the clock is already filled
# from the firmware, so nothing needs changing: Next takes it.
step "the time zone page is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name tz
    until
      bind up
      source tz
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Time, Zone], [Region]]
    max 40


step "next, with UTC as it was filled in"
  input 895 708
  click_at [1024, 768]
  settle 8


# PAGE 4 - LOCALE. `English` is preselected and the territory is `United States`; both are right.
step "the locale page is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name locale
    until
      bind up
      source locale
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Locale], [Language]]
    max 40


step "next, with English as it was filled in"
  input 895 708
  click_at [1024, 768]
  settle 8


# PAGE 5 - USERS. SEVEN REAL TEXT FIELDS, and this is where the graphical installer is decisively
# better than the text one: each is addressed by its own coordinate, so there is no `ret` that fails
# to move between them and no `down` that overshoots. MEASURED positions at 1024x768:
#
#	Root password     (460, 208)        Confirm        (460, 243)
#	Your real name    (460, 326)
#	Log-in name       (460, 362)
#	User password     (460, 397)        Confirm        (460, 432)
#	Computer name     (460, 468)   <- left at its default `openindiana`
step "the users page is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name users
    until
      bind up
      source users
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Root, password], [Your, real, name]]
    max 40


step "root password"
  input
    click [460, 208]
    click_at [1024, 768]
    text "{{ password }}"
  settle 2


step "root password again"
  input
    click [460, 243]
    click_at [1024, 768]
    text "{{ password }}"
  settle 2


step "the user's real name"
  input
    click [460, 326]
    click_at [1024, 768]
    text "{{ user }}"
  settle 2


step "the user's log-in name"
  input
    click [460, 362]
    click_at [1024, 768]
    text "{{ user }}"
  settle 2


step "the user's password"
  input
    click [460, 397]
    click_at [1024, 768]
    text "{{ password }}"
  settle 2


step "the user's password again"
  input
    click [460, 432]
    click_at [1024, 768]
    text "{{ password }}"
  settle 2


# THE COMPUTER NAME IS ALREADY `openindiana`, which is the name the smoke stage's screen reads and
# the ssh stage's `ssh_user` target expect, so it is left alone.
step "next, with the seven fields filled"
  input 895 708
  click_at [1024, 768]
  settle 10


# PAGE 6 - INSTALLATION SUMMARY. It lists the disk (`25.0 GB disk (c2t0d0)`), software, UTC, the
# locale and the user, and its button is `Install` rather than `Next`, in the same place.
step "the summary is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name summary
    until
      bind up
      source summary
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[Installation], [Review, the, settings]]
    max 40


step "install"
  input 895 708
  click_at [1024, 768]
  settle 20


# THE TRANSFER IS WAITED ON UNTIL THE WIZARD ITSELF SAYS `Finished`, AND THE SCREENSAVER IS UNLOCKED.
#
# TWO MEASUREMENTS DECIDE THIS SHAPE, AND EACH COST A RUN:
#
# 1  A FIXED `settle` IS EITHER TOO SHORT OR A GUESS. The transfer copies 1368 packages and measured
#    11.2 to 12.7 GiB across runs, taking twelve to twenty-two minutes. A `settle 600` published a
#    disk whose `/platform/i86pc/amd64` was EMPTY - the wizard was still writing when the machine was
#    killed - and that disk answered the loader's `No rootfs module provided, aborting`.
#
# 2  THE MATE SCREENSAVER LOCKS AFTER TEN MINUTES AND PAINTS THE SCREEN BLACK. MEASURED: a frame that
#    looked like a dead machine was the lock dialog, `Default User / jack on openindiana`, with the
#    install still progressing behind it. A gate that reads the screen therefore has to UNLOCK first,
#    or it reads a password box forever.
#
# SO THE LOOP BELOW TYPES `jack` AND RETURN WHEN THE LOCK IS UP, WHICH IS A NO-OP WHEN IT IS NOT, AND
# LOOKS FOR THE WIZARD'S OWN LAST PAGE: `Finished` with "OpenIndiana installation is complete". That
# sentence appears once, at the end, and is the wizard's statement rather than an inference.
# THE WIZARD'S OWN PAGE IS THE GATE, AND THE REBOOT IS ALSO A FINISH.
#
# MEASURED on run 45806933916, round by round:
#
#	[1.4]   Applications Places System ...          the live desktop, wizard still copying
#	[10.4]  Applications Places System ...          still copying
#	[25.4]  Booting... OpenIndiana Hipster ... vmuser   THE MACHINE REBOOTED, and `vmuser` is the
#	                                                unlock text this loop typed, echoed back
#	[40.4]  4, French 5, German 6, Italian ...      back at the live image's LANGUAGE page
#
# So the wizard finished and restarted the live system, and because the disc is still attached the
# machine booted THE DISC again - landing on the language selector, where ninety more rounds of
# `vmuser`+Return were typed into a menu that takes numbers.
#
# TWO THINGS FOLLOW, AND BOTH ARE IN THE LOOP BELOW:
#
# 1  THE LOCK IS ONLY UNLOCKED WHEN IT IS REALLY UP. The old loop typed the account name every round,
#    which is harmless on a desktop and destructive on a menu. `Enter your password` / `Default User`
#    is the lock's own text, so the typing happens only for it.
#
# 2  A REBOOT COUNTS AS FINISHED. `Booting...` on the console, or the language list on screen, means
#    the wizard closed - which is the same evidence as `installation is complete`, one page later. So
#    they are alternatives in the same gate, and the run stops pressing keys the moment either shows.
# NOTHING IS TYPED WHILE THE WIZARD IS COPYING, AND THE REASON IS THE 28% THAT RESTARTED.
#
# MEASURED on run 45806933916, from its own recording: at t=900s the wizard was on
# `Installing ... 28%`; at t=1100s the machine was printing `Booting...`. The install had NOT
# finished, and the only thing this walk was doing during that window was typing the account name and
# Return every 30 seconds "in case the lockscreen came up".
#
# ON THE LIVE DESKTOP A STRAY RETURN IS HARMLESS. IN THE WIZARD IT IS NOT: a `Return` activates
# whatever has focus, and the wizard's own buttons include `Quit`. A keystroke that lands during the
# transfer can therefore abandon it - which is exactly the shape of a jump from 28% to a reboot.
#
# SO THE WIZARD PHASE TYPES NOTHING. The screensaver is a risk only for the LONG tail after the
# copy, and it is handled by the step AFTER this one, which does not run until the copy is over.
# NOTHING IS TYPED WHILE THE WIZARD IS COPYING, AND THE REASON IS THE 28% THAT RESTARTED.
#
# MEASURED on run 45806933916, from its own recording: at t=900s the wizard was on
# `Installing ... 28%`; at t=1100s the machine was printing `Booting...`. The install had NOT
# finished, and the only thing this walk was doing during that window was typing the account name and
# Return every 30 seconds "in case the lockscreen came up".
#
# ON THE LIVE DESKTOP A STRAY RETURN IS HARMLESS. IN THE WIZARD IT IS NOT: a `Return` activates
# whatever has focus, and the wizard's own buttons include `Quit`. A keystroke that lands during the
# transfer can therefore abandon it - which is exactly the shape of a jump from 28% to a reboot.
#
# SO THE FIRST LOOP TYPES NOTHING AND ONLY WATCHES. It ends when the wizard says the install is
# complete, or when the live image has restarted (its language page or `Chinese`/`French` list is the
# tell). Only AFTER that does the deskclearing step below run, and it unlocks a lockscreen if one is
# up - which is safe then, because the wizard is closed and no button can be hit by accident.
# THE FINISH IS MEASURED FROM THE RECORDING, NOT GUESSED - AND THE FIRST VERSION GOT IT WRONG.
#
# MEASURED on run 45806933916, sampling its own recording every 25 seconds through the window I had
# previously written off as "28% then rebooted" without looking between the two frames:
#
#	t=900   Installing ... 28%
#	t=930   Installing ... 28%        (still copying)
#	t=950   Completing transfer process  99%      <- NINETY-NINE PERCENT
#	t=970   Completing transfer process  99%
#	t=995   the wizard is GONE, the live desktop is visible
#	t=1010  Welcome to illumos / 1. Boot Multi User / 6. Chainload disk0:   <- the DISK's own loader
#	t=1030  Loading unix... Booting... OpenIndiana Hipster 2026.10 ...
#	t=1400  Preparing live image for use / 1, Chinese - Simplified        <- from the CD again
#
# SO THE INSTALL DID FINISH, at about fifteen minutes, and the machine then rebooted into its own
# loader - and because this walk still has the installer CD attached at bootindex=0, that loader's
# menu timed out and the machine came back up from the DISC, landing on the language page.
#
# THE LESSON IS THE GATE, NOT THE TRANSFER: `installation is complete` is drawn for only a few
# seconds before the wizard closes itself, and a 25-second poll can miss it. The DISK's loader menu
# is the durable witness - it is on screen for the ten-second autoboot countdown and it is proof the
# install wrote a bootable system. `Boot Multi User` is that menu's own first row.
# A BLACK SCREEN IS THE FIRST THING THE SCREENSAVER DOES, AND NOTHING READ IT AS ONE.
#
# MEASURED on run 45825688651: round 1 read the live desktop; round 30 - about five minutes later -
# read `see: 0 word(s):`, and every round after that read the same empty string for the rest of the
# ninety-attempt budget. The MATE screensaver BLANKS the panel completely before it ever draws the
# lock dialog, so the `Enter your password` test this loop used to carry was looking for text that
# does not exist yet.
#
# SO THE LOOP WAKES THE PANEL FIRST, WITH A POINTER MOVE-AND-CLICK ON THE DESKTOP'S EMPTY MIDDLE at
# (512, 400). That is not a button: the desktop's icons are down the left edge and the wizard - when
# it is up - is a window whose centre is the progress page. A click there cannot press `Quit`, and it
# is what a person does to wake a screensaver.
#
# THE FOUR WITNESSES FOLLOW, IN THE ORDER THEY APPEAR:
#
#	installation is complete   the wizard's own last page, visible a few seconds
#	Boot Multi User            the DISK's loader menu, about ten seconds of autoboot
#	Chainload disk0            the same menu, its last row
#	Chinese                    the language page, which only returns after a reboot
#
# The first two are the wizard closing; the last two are the live image restarting, which only
# happens after the wizard closes. All four mean the install is over.
step "the install finishes and the disk's own loader comes up"
  repeat
    do
      # `click_at:` GOES BESIDE THE CLICK, NOT INSIDE A FOLDED `input:` - see
      # easydev-org/easyvm#14. The folded form nests the click in a child step, and the child is
      # what `rescalePoint` reads; the declaration stays on the parent and is never seen, so the
      # engine refuses a coordinate the file has already declared:
      #
      #	click (512, 400) is a coordinate measured at 1920x1080 but the framebuffer is 1024x768
      #
      # ...on a walk whose own `resolution: 1024x768` sits eight hundred lines above it.
      item "wake the panel, which blanks before it locks"
        input 512 400
        click_at [1024, 768]
        settle 3
      item "read the screen"
        read
          name done
      item "is it finished"
        check
          source done
          mode text
          name finished
          rect [0, 0, 1024, 768]
          rect_at [1024, 768]
          words [[installation, is, complete], [Boot, Multi, User], [Chainload, disk0], [Chinese]]
      item "leave it alone while it copies"
        settle 8
    until
      finished
    max 300


step "unlock the screen if the screensaver came up"
  repeat
    do
      item "read the screen"
        read
          name lockstate
      item "is the lockscreen up"
        check
          source lockstate
          mode text
          name locked
          rect [0, 0, 1024, 768]
          rect_at [1024, 768]
          words [[Enter, your, password], [Default, User]]
      item "type the account name when it is"
        if locked
          then
            item
              input text "{{ user }}"
              settle 2
            item
              input ret
              settle 3
      item "look again"
        settle 5
    until
      bind gone
      source lockstate
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      without [[Enter, your, password], [Default, User]]
    max 20


step "let the last extent land"
  settle 30


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
  save "{{ out }}"
