# OPENINDIANA 2026.10, THE TEXT INSTALLER, DRIVEN TO AN INSTALLED DISK.
#
# THIS INSTALLER IS A TUI, NOT A GRAPHICAL ONE, AND IT IS DRIVEN THE WAY A PERSON DRIVES IT: F2 is
# continue, F3 is back, the arrow keys move between fields and list rows, and Space selects a radio
# row. MEASURED end to end on the pod against OI-hipster-minimal-20261030.iso, 2026-11-23.
#
# THE ONE THING THAT IS NOT OBVIOUS IS THAT `ret` DOES NOT MOVE BETWEEN FIELDS ON THE USERS PAGE.
# MEASURED: `admin` was typed into Root password, `ret` was pressed, and the cursor was still in Root
# password - the second `admin` landed in the SAME box and the page ended with one field holding ten
# characters and five empty. `down` is what moves to the next field, so every field below is typed
# and then stepped away from.
#
# THE RED LINE AT THE BOTTOM IS A HINT, NOT AN ERROR. On the Network page it reads "Select the wired
# network configuration: Automatically or None." and it stays on screen after Automatically has been
# selected; waiting for it to disappear would hang. F2 is what moves on, once the radio is chosen.
#
# 1024x768 IS DELIBERATE. The text console renders 80x25 characters at the firmware's font size, and
# this file's screen reads were measured at this resolution. A 1080p framebuffer would change the
# glyph size and the rects with it.
walkthrough "openindiana 2026.10 - the text installer, to an installed desktop"
resolution 1024x768
recording_resolution 1024x768
var disk_gb
  default "25"
  from args.disk_gb
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [OI-hipster-minimal-20261030.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size "{{ disk_gb }}"


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=OI-hipster-minimal-20261030.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800


# THE LOADER PRINTS ON THE SERIAL LINE, SO THIS WAIT NEEDS NO OCR: GRUB's menu, then "Loading unix...",
# then "Booting...". MEASURED: boot_archive is loaded by firmware and decompressed by the kernel, and
# the text installer is on screen about two and a half minutes after "Booting...", which is why the
# console read is only the first half of the wait and the screen read that follows it is generous.
step "the loader has handed over to the kernel"
  until "Loading unix"
  from console
  timeout 300


step "the keyboard question is on screen"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name kb
    until
      bind asking
      source kb
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[keyboard, layout]]
    max 60


# 47 IS US-ENGLISH IN THIS LIST - "47. US-English" is its last row - and typing it and pressing Return
# is what the prompt says: "To select the keyboard layout, enter a number [default 47]".
step "keyboard layout 47, US-English"
  input text "47"
  settle 1


step "take it"
  input ret
  settle 25


step "the language question is on screen"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name lang
    until
      bind asking
      source lang
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[English]]
    max 40


# THE LANGUAGE PAGE'S DEFAULT IS 1 AND ITS ONLY ROW IS "1. English", so Return takes it.
step "english, the default"
  input ret
  settle 25


# THE GATE IS `installation menu`, NOT `Install OpenIndiana`, AND THE MEASUREMENT IS THE REASON.
#
# MEASURED on run 45665672035: sixty-one consecutive frames read the top line as
#
#	Welcome to the UpeniIndiana illumos-cs93fd?sad installation menu
#
# - `O` recognised as `U` and `OpenIndiana` as `UpeniIndiana`, on the SAME frame where the run before
# this one (45646822391) read `Install OpenIndiana` cleanly. The band is small and the glyphs are
# thin, so that word is not a stable witness; `installation menu` is, because it is longer, lower,
# and appears in every one of those sixty-one reads.
#
# THE MENU IS ALSO EVIDENCE ENOUGH ON ITS OWN: this text exists nowhere else in the installer, and
# the very next step presses Return on a row that is preselected.
step "the installation menu is on screen"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name menu
    until
      bind shown
      source menu
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[installation, menu]]
    max 60


# "1 Install OpenIndiana" is the menu's first row and its default answer.
step "install openindiana"
  input ret
  settle 30


step "the welcome page is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name welcome
    until
      bind up
      source welcome
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[F2_Continue], [Thanks, for, choosing]]
    max 40


step "continue past the welcome page"
  input f2
  settle 15


step "the disk page is up, with the virtio disk already ticked"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name disks
    until
      bind up
      source disks
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Where, should], [Virtio]]
    max 40


step "continue with the whole disk"
  input f2
  settle 15


# THE GPT WARNING PUTS THE CURSOR ON CANCEL, WHICH IS THE SAFE ANSWER AND THE WRONG ONE HERE. `right`
# moves the selection to Continue and Return takes it. MEASURED: without the `right` the dialog simply
# closes and nothing is installed.
step "accept the GPT warning, which starts on Cancel"
  do
    item
      input right
      settle 1
    item
      input ret
      settle 15


step "the fdisk page is up"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name fdisk
    until
      bind up
      source fdisk
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[whole, disk], [fdisk]]
    max 40


# "Use the whole disk (EFI)" IS THE PROPOSED AND PRESELECTED ROW, and it is the one that matches the
# GPT label the warning above just accepted. Return on it is enough; nothing needs moving.
step "the whole disk, EFI"
  input f2
  settle 20


step "the network page is up"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name net
    until
      bind up
      source net
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Computer, Name], [wired]]
    max 40


# THE CURSOR STARTS IN THE Computer Name BOX, ONE `down` FROM THE FIRST RADIO ROW. MEASURED: from
# there, one `down` reaches "Automatically", two reach "Manually", three reach "None", and Space
# selects whatever the cursor is on. Automatic is right because the daemon runs a DHCP server for the
# guest - the smoke stage reaches sshd on 172.30.0.2 through exactly this setting.
step "move to the Automatic row"
  input down
  settle 2


step "choose automatic configuration"
  input spc
  settle 3


step "continue, past the red hint line"
  input f2
  settle 15


step "the time zone page is up"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name tz
    until
      bind up
      source tz
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Time, Zone], [UTC/GMT]]
    max 40


# UTC/GMT IS THE FIRST ROW AND THE PRESELECTED ONE, and it is the only honest answer for a machine
# whose clock is the runner's.
step "UTC/GMT"
  input f2
  settle 12


step "the date and time page is up"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name date
    until
      bind up
      source date
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Date, and, Time], [Year], [Hour]]
    max 40


# THE PAGE IS PRELOADED FROM THE FIRMWARE'S CLOCK AND NEEDS NO EDITING.
step "the clock is already right"
  input f2
  settle 15


step "the users page is up"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name users
    until
      bind up
      source users
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Root, password], [Username]]
    max 40


# SIX FIELDS, AND `down` IS WHAT MOVES BETWEEN THEM - NOT Return, which is measured above to leave the
# cursor where it was. The order on the page is Root password, its Confirm, Your real name, Username,
# User password, its Confirm; the `down` after the last one lands back on F2's row and does nothing.
step "type the root password"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "move down to the root password again"
  input down
  settle 1


step "type the root password again"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "move down to the real name"
  input down
  settle 1


step "type the real name"
  input text "{{ user }}"
  settle 2


step "move down to the username"
  input down
  settle 1


step "type the username"
  input text "{{ user }}"
  settle 2


step "move down to the user's password"
  input down
  settle 1


step "type the user's password"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "move down to the user's password again"
  input down
  settle 1


step "type the user's password again"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "the users page took all six"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name filled
    until
      bind ok
      source filled
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [["{{ user }}"]]
    max 20


step "continue from the users page"
  input f2
  settle 15


step "the summary page is up"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name summary
    until
      bind up
      source summary
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Installation, Summary], [F2_Install]]
    max 40


step "install"
  input f2
  settle 30


# THE TRANSFER IS THE LONG PART: MEASURED at roughly 3500 MiB written in about three minutes on the
# pod, then a minute more for the boot environment to be created. The page's own progress line and
# the final "Installation Complete" both sit in the same box, so this waits for the words that only
# the finished page carries.
step "the transfer finished"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name done
    until
      bind finished
      source done
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[Installation, Complete], [F8_Reboot]]
    max 80


# THE DESKTOP IS PART OF "INSTALLED", AND THIS IS WHERE IT IS INSTALLED.
#
# `Installation Complete` IS A DISK WITH NO DESKTOP ON IT. OpenIndiana's text installer writes a
# system and stops; `mate_install` is a separate package group and the display manager is a service
# that has to be enabled, so a disk published straight from that screen boots to a text login and
# nothing else.
#
# EVERY OTHER REPOSITORY HERE INSTALLS ITS DESKTOP IN THIS STAGE. `sd-bsd/freebsd/steps/install.walk`
# runs `pkg install ... xfce lightdm lightdm-gtk-greeter` from the installer's own root shell, and
# its ssh stage only turns on remote access. So this stage does the same, and the ssh stage that
# follows is short because there is nothing left for it to install.
#
# THE INSTALLER HAS NO SHELL TO TYPE INTO, which is the one thing that is different: the text
# installer's last page offers F8 to reboot and nothing else. So the disk is stopped, booted again -
# this time with no ISO - and the work is done at the installed system's own console.
#
# 1024x768 IS KEPT, because it is what this file's installer screens were measured at and what its
# `-device VGA` asks for. The rects below are the ssh stage's, narrowed to this framebuffer.
step "power the installer's machine off, because the next boot describes another one"
  stop kill
  timeout 120


step "boot the installed system, with no installer media attached"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


# THE INSTALLED SYSTEM'S BOOT MENU COMES UP FIRST, AND IT WAITS FOR A RETURN.
#
# MEASURED on run 45667527362: the frame the wait kept reading was
#
#	1. Boot Multi User [Enter]  2. Boot Single User  3. Escape to loader prompt  4. Reboot
#
# - the illumos loader's own menu, which does not count down. The step that types the account name
# was pressed against this menu, every keystroke was eaten as a menu choice, the login never
# happened, `pkg install` never ran, and the run spent fifty minutes waiting for a PKG_EXIT line
# that could not appear. It is the same failure 45646822391 hit one menu earlier, at GRUB.
#
# SO THE RETURN IS INSIDE THE WAIT, the same shape the tribblix install uses: a Return on this menu
# takes its preselected first row ("Boot Multi User"), and a Return at a login prompt merely redraws
# the prompt. The retry cannot overshoot, and the prompt is still the witness.
step "the installed system has reached its login"
  repeat
    do
      item
        settle 10
      item "boot the default entry, or redraw a prompt that is already up"
        input ret
      item "read the screen"
        read
          name login
    until
      bind up
      source login
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      # ONE WORD PER ELEMENT, NOT ONE STRING WITH A COMMA IN IT. `[["console, login"]]` asks the reader
      # for a single word `console, login` - punctuation and all - which no screen has ever shown. The
      # wait then ran its whole sixty attempts and the stage died at the login it was waiting for.
      # MEASURED on run 45665672035: step 46 burned twenty-five minutes and every reading was a miss.
      words [[console, login]]
    max 60


step "log in at the console as the account that exists"
  input text "{{ user }}"
  type_gap 0.1
  settle 2


step "take the login name"
  input ret
  settle 6


step "type the account password"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "take the password"
  input ret
  settle 10


step "read what the console says after logging in"
  read
    name after_login


# THE PROMPT ITSELF, NOT A `$`. A bare dollar sign is a glyph OCR reads as `S`, `s` or nothing, and
# a check that cannot see it would fail on a login that worked. `vmuser@openindiana` is the shell's
# own name for the account, which is what a successful login actually prints.
step "the console is a shell, not a refusal"
  check
    source after_login
    mode text
    rect [0, 0, 1024, 768]
    rect_at [1024, 768]
    words [["vmuser@openindiana"]]
    without [incorrect, "Permission denied"]
    name console_shell


step "assume the root role"
  input text "su -"
  type_gap 0.1
  settle 2


step "send the role request"
  input ret
  settle 6


step "type the root role password"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "take the role password"
  input ret
  settle 10


step "read what the console says after su"
  read
    name after_su


# THE PROOF IS THE LINE `su` ITSELF PRINTS, WHICH THE 7f0459b CONSOLE SHOWS VERBATIM:
#
#	Nov 25 13:09:33 openindiana su: 'su root' succeeded for vmuser on /dev/console
#	root@openindiana:~#
#
# `root@` IS THE SHELL'S OWN PROMPT for the assumed identity, which is a fact about the session
# rather than about the word "root" appearing somewhere on the screen - the mistake the 368f6db run's
# check made when it matched the login prompt's own text.
step "the root role was assumed"
  check
    source after_su
    mode text
    rect [0, 0, 1024, 768]
    rect_at [1024, 768]
    without [incorrect, "Permission denied", "can only be assumed", "not a valid"]
    words [["root@openindiana"]]
    name role_assumed


# THE AUTHORIZATION IS GRANTED IN THE CONSOLE'S ROLE AND PROVEN OVER SSH.
#
# Both halves are needed: `usermod` must run with privilege, which only the assumed role has, and the
# result must be visible to a NEW ssh session, which is where `pkg` runs. Doing the grant over the
# console and the proof over ssh also keeps the two independent - a session that inherited the
# authorization could not be evidence that it was granted.
# THE GRANT IS A PROFILE, NOT AN AUTHORIZATION NAME, AND THE CONSOLE SAID SO IN ONE LINE.
#
# MEASURED on the 7f0459b run, in the assumed root shell:
#
#	root@openindiana:~# usermod -A +solaris.admin.packager vmuser
#	UX: usermod: ERROR: +solaris.admin.packager is not a valid authorization.  Choose another.
#
# `-A` takes a name from `/etc/security/auth_attr`; `solaris.admin.packager` is the AUTHORIZATION a
# package operation checks, but it is not itself declared as a login authorization. What `pkg`
# really wants is the PROFILE that carries it, and illumos names that one `Solaris Package Manager`.
#
# `-P +"Solaris Package Manager"` APPENDS the profile and leaves the ones the installer already set
# alone - the same `+` semantics `-A` has, on the other list.
#
# THE NAME IS PRINTED FROM THIS SYSTEM RATHER THAN ONLY TRUSTED. If the profile were called something
# else, the line before the grant would show it, and `usermod` would name the replacement - which is
# exactly how the run above got from a wrong authorization name to this one.
# THIS SYSTEM HAS NO PACKAGE PROFILE TO GRANT, AND THE CONSOLE SAID SO IN TWO LINES.
#
# MEASURED on the 49e152e run, in the assumed root shell:
#
#	root@openindiana:~# grep -i package /etc/security/prof_attr
#	root@openindiana:~#                                   <- NO OUTPUT
#	root@openindiana:~# usermod -P +'Solaris Package Manager' vmuser
#	UX: usermod: ERROR: +Solaris Package Manager is not a valid profile name.  Choose another.
#
# AND `profiles` FOR THE ACCOUNT DID NOT GAIN IT EITHER:
#
#	Console User, Suspend To RAM, Suspend To Disk, Brightness, CPU Power Management,
#	Network Autoconf User, Basic Solaris User, All
#
# `Solaris Package Manager` IS A SOLARIS 11 PROFILE AND THIS IS NOT SOLARIS 11. OpenIndiana Hipster
# ships IPS without a profile named for it, so there is nothing to grant and no authorization name to
# append - the two previous attempts failed on exactly that, from opposite directions.
#
# SO THE PACKAGE OPERATION RUNS IN THE ROOT SHELL, WHICH IS THE ONE PLACE ON THIS SYSTEM IT IS
# PROVEN TO WORK. `su -` already succeeded and the prompt is `root@openindiana:~#`. Running `pkg`
# there is not a workaround - it is the privileged context this disk actually has.
#
# THE RISK IS THE RECORDING, NOT THE COMMAND: a 90-minute `pkg` run holds the console, so the step's
# own output is the only thing the log will show. That is acceptable here because `pkg` writes its
# progress to the terminal this step is typing into.
#
# AND THE PROOF MOVES TO WHERE IT BELONGS: `pkg` EXITS NON-ZERO IF IT COULD NOT INSTALL, and the
# desktop's own session file is then checked over ssh - which is a fact about the system rather than
# about a name in an authorization list.
#
# `mate_install` AND `lightdm`, NOT `solaris-desktop` AND `gdm`, AND THREE RUNS ARE WHAT SAID SO.
# OpenIndiana's own handbook, under "Installing OpenIndiana", gives the two commands this stage
# needs:
#
#	pkg install mate_install
#	svcadm enable -r /application/graphical-login/lightdm
#
# MATE IS THIS DISTRIBUTION'S DEFAULT DESKTOP; `solaris-desktop` is a Solaris 11 group with no
# equivalent here, and `gdm` is not the display manager it ships. MEASURED: three runs installed
# `solaris-desktop` successfully - `pkg` returned 0 - and `/usr/share/xsessions/gnome.desktop` was
# still absent afterwards, because nothing had been installed under that name at all.
#
# `yes |` AND A LOG FILE, BECAUSE `pkg` ASKS A QUESTION THE CONSOLE CANNOT SEE THE END OF.
#
# MEASURED on run 45630040587, which waited properly and then read `PKG_EXIT=1`: the screen held an
# entire licence agreement - `LOSS OF GOODWILL, WORK STOPPAGE...`, `OR CONSEQUENTIAL DAMAGES` - so
# `pkg` had stopped to ask whether the terms were accepted and refused on its own timeout. The console
# is a screen this walk types at, not a terminal a person scrolls, so a prompt hundreds of lines down
# cannot be answered there.
#
# `yes` ANSWERS IT, and `--accept` still carries "do not ask me to confirm the install". Redirection to
# a file keeps that agreement out of the recording, and `tail -5` puts the part that matters - the last
# five lines of the real outcome - back on the console where the exit line is read from.
# `-r` ON THE ENABLE IS NOT OPTIONAL: it restarts the service and the ones that depend on it, which is
# what makes lightdm actually come up rather than record that it should.
# `--licenses` IS WHAT PRINTED THE LICENCE, AND `--accept` IS ALL THE INSTALL NEEDS.
#
# THE MAN PAGE SETTLES IT (pkg(1), illumos and OmniOS - both documented from the same source):
#
#	--accept   Indicate that you agree to and accept the terms of the licenses of the packages
#	           that are updated or installed. If you do not provide this option, and any package
#	           licenses require acceptance, the installation operation fails.
#
#	--licenses Display all of the licences for the packages that are installed or updated as part
#	           of this operation.
#
# SO `--accept --licenses` ACCEPTS THE LICENCE AND THEN PRINTS EVERY LINE OF IT TO THE CONSOLE. That
# is the wall of CDDL text every failing run of this stage sat on - 379 words of "This U.S.
# Government Rights clause is in lieu of ..." - and `PKG_EXIT` was never printed because `pkg` was
# still writing the licence out, not because it was waiting for an answer.
#
# MEASURED on run 45681423101: forty minutes of licence body in the frame, the exit line never
# written, `mate_install` never installed.
#
# `--licenses` was added on the theory that `pkg` was PROMPTING for a licence. It never prompts: it
# fails when `--accept` is absent (the man page says so above), and `--licenses` is a display flag.
# Removing it is the fix, and `--accept` alone is the non-interactive form.
#
# `yes | pkg install` DOES NOT ANSWER THE LICENCE PROMPT, AND THE RECORDING SAYS WHY.
#
# MEASURED on run 45681423101, whose console held nothing but licence text for forty minutes:
#
#	herein. This U.S. Government Rights clause is in lieu of, and supersedes, any other FAR, DFAR,
#	or other clause or provision that addresses Government rights in computer software ...
#	--- NOTICE PURSUANT TO SECTION 9 OF THE COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL)
#	root@openindiana:~#
#
# `pkg` READS ITS CONFIRMATION FROM THE TERMINAL, NOT FROM STDIN. A pipe answers stdin, so `yes |`
# fed a question that was never read from there, and the command sat waiting with its prompt drawn on
# the screen this walk is supposed to watch.
#
# SO THE COMMAND RUNS IN THE FOREGROUND AND THE PROMPT IS ANSWERED FROM THE CONSOLE. `y` then Return
# is what a person types at that prompt, and the loop below is built to keep answering until the
# licence page is gone rather than assuming one `y` is enough - some images ask once per publisher.
step "install the desktop in the root shell"
  input text "pkg install --accept --deny-new-be mate_install > /tmp/pkg.log 2>&1; echo PKG_EXIT=$? | tee /tmp/pkg.exit"
  type_gap 0.05
  settle 3


step "run the install"
  input ret
  settle 15


# THE LICENCE PAGE, ANSWERED UNTIL IT IS GONE. `PKG_EXIT` CANNOT APPEAR WHILE A PROMPT IS WAITING, so
# this loop runs BEFORE the exit line is waited for: it types `y` whenever the screen shows the
# licence, and it ends when the licence text is no longer there.
step "answer the licence pages until the install proceeds"
  repeat
    do
      item "read the screen"
        read
          name lic
      item "is a licence page up"
        check
          source lic
          mode text
          name licensed
          rect [0, 0, 1024, 768]
          rect_at [1024, 768]
          words [[CDDL], [PUBLIC, LICENSE], [Government, Rights], [GOVERNMENT, RIGHTS]]
      item "say yes whenever the licence is on screen"
        if licensed
          then
            item
              input text "y"
            item
              input ret
              settle 8
      item
        settle 5
    until
      bind proceeded
      source lic
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      without [CDDL, "PURSUANT TO SECTION 9", "Government Rights", "GOVERNMENT RIGHTS"]
    max 40


# THE EXIT LINE IS ALSO WRITTEN TO A FILE, BECAUSE THE CONSOLE SCROLLS IT AWAY.
#
# MEASURED on run 45694800660, and this is the failure `--accept` alone did not fix: the licence loop
# DID see the line - its own log reads
#
#	answer the licence pages until the install proceeds [until]: __until__ = true (read "PKG_EXIT")
#
# and the disk that run published was 19 GB with `mate_install` on it. The stage failed anyway,
# because `pkg`'s own post-install work prints SMF defects to the same console:
#
#	SUNW-MSG-ID: SMF-8000-YX, TYPE: defect, VER: 1, SEVERITY: major
#
# and by the time the step after the loop read the screen, the exit line had been pushed off it. The
# install SUCCEEDED and the walk could not see it.
#
# SO THE COMMAND RECORDS ITS STATUS IN /tmp/pkg.exit AS WELL, and a step of its own `cat`s it. A
# three-word line does not scroll away, and `PKG_EXIT` is still the gate because this console's reader
# cannot tell `0` from `O` (see the note below).
# `--deny-new-be` IS WHAT KEEPS THE MACHINE ON THE CONSOLE INSTEAD OF REBOOTING OUT OF IT.
#
# MEASURED on run 45707724998: the licence loop was still waiting when the screen turned into the
# BOOT SEQUENCE of the same machine -
#
#	Loading unix... Loading /platform/i86pc/amd64/boot_archive...
#	Booting... OpenIndiana Hipster 2026.10 Version ...
#
# `pkg install` on OpenIndiana creates a new boot environment by default and activates it, and the
# SMF actuators that follow a large install restart the system. A restart destroys the console this
# walk drives: `/tmp` is memory, so `/tmp/pkg.exit` goes with the shell that wrote it, and every
# keystroke after that lands on a login prompt nobody asked for. It is also why reading the file did
# not help on that run even though the file had been written.
#
# `--deny-new-be` tells pkg not to create the boot environment (pkg(1): "Do not create a new boot
# environment. This operation will fail if this option is specified and the operation requires a new
# boot environment."). `mate_install` is an ordinary package set and does not require one, so the
# packages land in the running BE and nothing reboots.
#
# `cat` IS INSIDE THE LOOP, BECAUSE THE FILE APPEARS WHEN `pkg` FINISHES AND NOT BEFORE.
#
# MEASURED on runs 45694800660 and 45707724998: `pkg install mate_install` takes forty to fifty
# minutes, and its output SCROLLS - the console was still showing boot text when the licence loop gave
# up, so nothing that reads the screen can tell "still installing" from "finished".
#
# `/tmp/pkg.exit` is written by the command itself (`| tee /tmp/pkg.exit`) and holds three words. It is
# the only record that survives the scroll, and a `cat` that runs before the file exists simply prints
# an error - so the cat is repeated rather than assumed.
step "the recorded status is the line the loop saw"
  repeat
    do
      item "ask the file where the install got to"
        input text "clear; cat /tmp/pkg.exit 2>/dev/null"
      item
        input ret
        settle 8
      item "read the screen"
        read
          name pkgfile
    until
      bind up
      source pkgfile
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [[PKG_EXIT]]
    max 400


# THE EXIT CODE IS NOT RE-READ HERE, AND THE ZERO IS WHY. `PKG_EXIT=0` cannot be matched by this
# console's reader (see the note in the wait above), and a check that repeats an unreadable word adds a
# failure without adding evidence.
#
# THE PROOF IS THE NEXT STEP AND IT IS A BETTER ONE: it asks the PUBLISHED SYSTEM, over scp/ssh,
# whether `mate.desktop` exists. That is a fact about the disk rather than about a line of console
# output, and it cannot be satisfied by a command that never ran.


# THE OLD "wait for the install to finish" STEP IS GONE ON PURPOSE.
#
# It existed to read `pkg`'s exit line off the console with a 40-minute ceiling. The licence loop
# above already reaches that line (`__until__ = true (read "PKG_EXIT")` on run 45694800660), and the
# step right here re-prints it from a FILE, where no post-install SMF message can scroll it away. A
# second wait on the same line would only re-introduce the failure this step was added to end.


step "prove the session is installed"
  ssh "ls -l /usr/share/xsessions/mate.desktop"
  timeout 120


# THE DISPLAY MANAGER IS ENABLED IN THE SAME ROOT SHELL, FOR THE SAME REASON THE INSTALL WAS.
# `pfexec svcadm enable` from vmuser's session is another command the account is not entitled to run -
# the 49e152e run showed `pfexec` reaching nothing it did not already own.
step "enable the display manager in the root shell"
  input text "svcadm enable -r svc:/application/graphical-login/lightdm:default; echo DM_EXIT=$?"
  type_gap 0.05
  settle 3


step "run the enable"
  input ret
  settle 10


step "the display manager reports online"
  ssh "svcs -H -o state svc:/application/graphical-login/lightdm:default"
  timeout 180


# A DISPLAY MANAGER THAT IS ONLINE AND A GNOME SESSION ARE TWO DIFFERENT FACTS, and this system is
# slow enough to reach the second one minutes after the first. The screen is the only thing that can
# tell them apart, so the walk looks at it - the same picture gate every other desktop wait here uses.
step "the desktop is on screen"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name screen
    until
      bind desktop
      source screen
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      words [["Applications"]]
    max 60



step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
