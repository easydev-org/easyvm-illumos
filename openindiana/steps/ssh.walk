walkthrough "openindiana 2026.10 - sshd, a desktop, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
# THE ACCOUNT THAT LOGS IN IS THE ONE THE INSTALLER CREATED, BECAUSE IT IS THE ONLY ONE THAT CAN.
#
# MEASURED, FOUR RUNS, AND EACH CLOSED A DIFFERENT DOOR:
#
#	45612202261  `sudo pkg install -y ...`       -> bash: line 1: sudo: command not found
#	45613187768  pfexec present, `profiles: All`, then pkg install -> Insufficient access
#	bd0900f run  `auths` has NO solaris.admin.packager; `pfexec usermod -A` -> Permission denied
#	ec7c6cb run  `ssh_user root`, and the console of that run shows why that cannot work either:
#
#		openindiana console login:
#		sshd-session[1167]: error: PAM: Authentication failed for root from 172.30.0.1
#
#	             repeated every minute for the whole budget. The system booted perfectly -
#	             illumos-c893fd03ad, 151/151 service descriptions, `Hostname: openindiana` - and
#	             answered sshd; the ROOT PASSWORD IS NOT THE ONE THE INSTALL WALK TYPED. So vmuser
#	             is the only account that authenticates, and it has no privilege.
#
# THE PRIVILEGE IS THEREFORE ESTABLISHED ONCE, AT THE CONSOLE, WHICH IS THE INTERFACE THE INSTALLER
# ITSELF USED. This is the first stage that boots the installed disk, so it is where the account the
# installer left behind gets completed; every later stage inherits the result.
ssh_user vmuser
var user
  default vmuser
  from args.user
var out
  default out/openindiana-ssh.qcow2
  from args.out
password admin
ssh_port 2222

step "boot the installed disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


# THE INSTALLER'S NETWORK PAGE WAS SET TO "AUTOMATICALLY", AND THIS IS THE STAGE THAT DEPENDS ON IT.
#
# `smoke.walk` already reads the console login prompt of `172.30.0.2`, so the interface comes up on
# its own and sshd answers. The wait is for `machine_ssh`, which the daemon probes on its own
# ticker - not a console line, because `sshd` logs to a file on this system rather than to the
# console the walk can see.
step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un"
  timeout 120


step "prove the boot environment is the one that was installed"
  ssh "beadm list"
  timeout 120


# THE AUTHORIZATION HAS TO EXIST BEFORE ANY `ssh` STEP CAN USE IT, AND NO `ssh` STEP CAN CREATE IT.
#
# Run bd0900f showed both halves of that at once: `auths` listed the ordinary user authorizations and
# NOT `solaris.admin.packager`, and `pfexec usermod -A +solaris.admin.packager vmuser` answered
#
#	UX: usermod: ERROR: Permission denied.
#
# The account cannot grant itself what it does not have. But root can - if root were reachable over
# ssh, which the ec7c6cb run proved it is not (`PAM: Authentication failed for root` for ten minutes,
# while the same disk's console showed a perfectly healthy boot).
#
# SO THE CHANGE IS MADE AT THE CONSOLE, WHICH IS THE INTERFACE THE INSTALL WALK ITSELF DROVE. The text
# installer typed a root password on this very screen; the console therefore has an administrator the
# network does not. Two keystrokes reach it and one command grants the authorization that every `ssh`
# step after this needs.
#
#	`root` + Return            the console login prompt is on screen after boot - `smoke.walk` proves
#	                           that, and it is the one thing every run of this stage has shown
#	the root password         the same `{{ password }}` the install walk typed into the installer's
#	                           root field
#
# THE TYPING IS SEQUENCED LIKE THE INSTALLER'S USERS PAGE: `type` with a gap, then Return, because
# this console echoes nothing and a password sent faster than it can read is a password that lost
# characters.
#
# IF THIS FAILS, THE MESSAGE IS THE ANSWER: a wrong root password, a prompt that never appeared, or
# an `usermod` that still refuses. Each is a different line in this log, which is why the step is
# named for what it establishes rather than for what it types.
step "type root at the login prompt"
  input text root
  type_gap 0.1
  settle 2


step "take the login name"
  input ret
  settle 6


step "type the root password at the console"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "take the root password"
  input ret
  settle 8


step "read the console"
  read
    name console


step "prove the console is a root shell"
  check
    source console
    mode text
    rect [0, 0, 1920, 200]
    rect_at [1920, 1080]
    words [[root]]
    name console_is_root


# THE AUTHORIZATION IS FOR `pkg` SPECIFICALLY, BECAUSE THAT IS WHAT REFUSED IT.
#
# `pkg` needs `solaris.admin.packager`; `usermod -A` appends one authorization without touching the
# ones the installer already put there. `-P` would replace the profile list, which is not what is
# wanted here - the account already has what it needs to be a desktop user.
step "grant the packager authorization from the console"
  input text "usermod -A +solaris.admin.packager {{ user }}"
  type_gap 0.1
  settle 2


step "run the grant"
  input ret
  settle 5


step "prove a fresh session carries the authorization"
  ssh "auths"
  timeout 60


# THE DESKTOP IS WHAT THIS STAGE ADDS, AND IT IS INSTALLED AS THE ACCOUNT THE INSTALLER CREATED.
#
# `--accept`, NOT `-y`, AND THE FIRST RUN IS WHAT SAID SO. MEASURED on run 45613187768:
#
#	pkg install: illegal option -- y
#	Usage: pkg install [-nvq] [-C n] [-g path_or_uri ...] [--accept]
#	                   [--licenses] ...
#
# `pkg` is IPS and takes `--accept` for "do not ask me to confirm"; `--licenses` is the second
# consent a publisher's own packages need, and a desktop group certainly has one.
#
# `solaris-desktop` IS THE PUBLISHER'S OWN GROUP for the GNOME desktop rather than a list of
# packages, because naming them one by one is how a desktop ends up installed but unusable - a
# session file with nothing to start it.
#
# NOTE: THE PACKAGE ITSELF HAS NOT RESOLVED YET. Runs so far established the account, the option
# spelling and the authorization answer; the group's name, whether `gdm` is the display manager that
# ships with it, and how long it takes are what the next run has to confirm.
#
# THE TIMEOUT IS LONG BECAUSE `pkg` RESOLVES AGAINST THE NETWORK. Ninety minutes is the ceiling a
# leg has, not an expectation.
step "install the desktop"
  ssh "pfexec pkg install --accept --licenses solaris-desktop"
  timeout 5400


step "prove the session is installed"
  ssh "ls -l /usr/share/xsessions/gnome.desktop"
  timeout 120


step "the display manager is the one that starts"
  ssh "svcs -H -o state svc:/application/graphical-login/gdm:default || true"
  timeout 120


step "enable the display manager at boot"
  ssh "pfexec svcadm enable svc:/application/graphical-login/gdm:default"
  timeout 180


step "the display manager reports online"
  ssh "svcs -H -o state svc:/application/graphical-login/gdm:default"
  timeout 120


# A DISPLAY MANAGER THAT IS ONLINE AND A GNOME SESSION ARE TWO DIFFERENT FACTS, and this system is
# slow enough to reach the second one minutes after the first. The screen is the only thing that can
# tell them apart, so the walk looks at it - the same picture gate every other desktop wait here uses.
step "the desktop is on screen"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name screen
    until
      bind desktop
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [["Activities"]]
    max 60


step "flush the writes before anything else"
  ssh "pfexec sync"
  timeout 300


step "flush the writes before the machine stops"
  ssh "pfexec sync"
  timeout 300


# `stop ssh` RATHER THAN `stop power`: an ACPI power press asks the desktop to shut down, and a
# desktop that is still bringing itself up may ignore it for the whole timeout. `stop ssh` sends the
# command and tolerates the session ending with the machine, which is what `shutdown` does.
step "shut the machine down"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
