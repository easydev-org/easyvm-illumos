walkthrough "openindiana 2026.10 - sshd, a desktop, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
# ROOT IS A ROLE ON THIS SYSTEM, NOT AN ACCOUNT, AND THAT IS WHY FOUR RUNS FAILED.
#
# EACH RUN CLOSED ONE DOOR, AND THE FOURTH ONE IS THE SCREENSHOT THAT EXPLAINS ALL OF THEM:
#
#	45612202261  `sudo pkg install -y ...`   -> bash: line 1: sudo: command not found
#	                                              (illumos has no sudo at all)
#	45613187768  pfexec present, profiles: All, then pkg -> `Insufficient access`
#	bd0900f run  auths has NO solaris.admin.packager; `pfexec usermod -A ...` -> Permission denied
#	ec7c6cb run  `ssh_user root` -> every ssh attempt refused, once a minute:
#	                                              `PAM: Authentication failed for root from 172.30.0.1`
#	368f6db run  the same disk, logged in AT THE CONSOLE as root, answers:
#
#		openindiana console login: root
#		Password:
#		Roles can only be assumed by authorized users
#		Login incorrect
#		openindiana login: login account failure: Permission denied
#
# ROOT IS A ROLE. Illumos RBAC makes `root` a role whose identity cannot be logged in to directly -
# not on ssh, not at the console. It is ASSUMED from an account that is authorized to assume it, and
# the installer's `vmuser` is the account that exists. So:
#
#	vmuser is who logs in                it authenticates over ssh (every run proved that)
#	`su -` is how root is assumed        the role is entered, not logged in to
#	inside it, one `usermod` grants      the authorization `pkg` requires
#
# AND THE THIRD RUN SHOWED WHY THAT GRANT HAS TO HAPPEN: `auths` for vmuser listed
# solaris.admin.wusb.read, solaris.device.cdrw, solaris.device.mount.removable, solaris.mail.mailq and
# solaris.profmgr.read - and NOT solaris.admin.packager, which is what IPS checks. `profiles: All`
# grants COMMANDS; `pkg` asks for an AUTHORIZATION, and the two lists are different files.
#
# THE GRANT IS MADE OVER SSH ONCE THE ROLE IS ASSUMED, not typed at the console: the console on this
# system needs a login the installer's own screen never established for us, while `su` inside an
# authenticated ssh session is the supported way to enter a role.
ssh_user vmuser
var user
  default vmuser
  from args.user
var out
  default out/openindiana-ssh.qcow2
  from args.out
password admin
ssh_port 2222

step "boot the installed disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


# THE INSTALLER'S NETWORK PAGE WAS SET TO "AUTOMATICALLY", AND THIS IS THE STAGE THAT DEPENDS ON IT.
#
# `smoke.walk` already reads the console login prompt of `172.30.0.2`, so the interface comes up on
# its own and sshd answers. The wait is for `machine_ssh`, which the daemon probes on its own
# ticker - not a console line, because `sshd` logs to a file on this system rather than to the
# console the walk can see.
step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un"
  timeout 120


step "prove the boot environment is the one that was installed"
  ssh "beadm list"
  timeout 120


# THE ROLE IS ASSUMED AT THE CONSOLE, FROM THE ACCOUNT THAT CAN LOG IN THERE.
#
# TWO MEASURED FACTS DECIDE THE SHAPE OF THIS, AND EACH KILLED A PREVIOUS ATTEMPT:
#
#	`su -c` IS NOT A THING HERE. MEASURED on the 6b300e1 run:
#
#		ssh: printf '%s\n' 'admin' | su -c 'usermod -A ...' -> 1
#		Usage: su [-] [ username [ arg ... ] ]
#
#	illumos `su` takes a USERNAME and then ARGUMENTS for that user's shell - there is no `-c`.
#
#	AND `su` DOES NOT READ A PASSWORD FROM A PIPE ANYWAY: it opens the terminal, so a password sent
#	down stdin is never seen. That is why the assumption happens on the CONSOLE, which IS a
#	terminal, rather than over ssh, which is not.
#
# THE ACCOUNT IS `vmuser`, NOT `root`. The 368f6db run typed `root` at that prompt and the console
# answered, in its own words:
#
#	Roles can only be assumed by authorized users
#	Login incorrect
#	login account failure: Permission denied
#
# `vmuser` is the account the installer created, its password is this `{{ password }}`, and every run
# since 45612202261 has authenticated with it. So the console logs in as vmuser and then ASSUMES the
# root role with `su`, which is the operation illumos RBAC defines for exactly this.
#
# EACH KEYSTROKE GROUP IS ITS OWN STEP WITH A SETTLE, because a console echoes no password and gives
# no newline until Return. The checks read the SCREEN rather than matching a word that the prompt
# itself contains - the 368f6db run's `words [[root]]` passed on the login prompt's own text.
step "log in at the console as the account that exists"
  input text "{{ user }}"
  type_gap 0.1
  settle 2


step "take the login name"
  input ret
  settle 6


step "type the account password"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "take the password"
  input ret
  settle 10


step "read what the console says after logging in"
  read
    name after_login


step "the console is a shell, not a refusal"
  check
    source after_login
    mode text
    rect [0, 0, 1920, 400]
    rect_at [1920, 1080]
    words [[$]]
    without [incorrect, "Permission denied"]
    name console_shell


step "assume the root role"
  input text "su -"
  type_gap 0.1
  settle 2


step "send the role request"
  input ret
  settle 6


step "type the root role password"
  input text "{{ password }}"
  type_gap 0.1
  settle 2


step "take the role password"
  input ret
  settle 10


step "read what the console says after su"
  read
    name after_su


# THE PROOF IS THE LINE `su` ITSELF PRINTS, WHICH THE 7f0459b CONSOLE SHOWS VERBATIM:
#
#	Nov 25 13:09:33 openindiana su: 'su root' succeeded for vmuser on /dev/console
#	root@openindiana:~#
#
# `root@` IS THE SHELL'S OWN PROMPT for the assumed identity, which is a fact about the session
# rather than about the word "root" appearing somewhere on the screen - the mistake the 368f6db run's
# check made when it matched the login prompt's own text.
step "the root role was assumed"
  check
    source after_su
    mode text
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    without [incorrect, "Permission denied", "can only be assumed", "not a valid"]
    words [["root@openindiana"]]
    name role_assumed


# THE AUTHORIZATION IS GRANTED IN THE CONSOLE'S ROLE AND PROVEN OVER SSH.
#
# Both halves are needed: `usermod` must run with privilege, which only the assumed role has, and the
# result must be visible to a NEW ssh session, which is where `pkg` runs. Doing the grant over the
# console and the proof over ssh also keeps the two independent - a session that inherited the
# authorization could not be evidence that it was granted.
# THE GRANT IS A PROFILE, NOT AN AUTHORIZATION NAME, AND THE CONSOLE SAID SO IN ONE LINE.
#
# MEASURED on the 7f0459b run, in the assumed root shell:
#
#	root@openindiana:~# usermod -A +solaris.admin.packager vmuser
#	UX: usermod: ERROR: +solaris.admin.packager is not a valid authorization.  Choose another.
#
# `-A` takes a name from `/etc/security/auth_attr`; `solaris.admin.packager` is the AUTHORIZATION a
# package operation checks, but it is not itself declared as a login authorization. What `pkg`
# really wants is the PROFILE that carries it, and illumos names that one `Solaris Package Manager`.
#
# `-P +"Solaris Package Manager"` APPENDS the profile and leaves the ones the installer already set
# alone - the same `+` semantics `-A` has, on the other list.
#
# THE NAME IS PRINTED FROM THIS SYSTEM RATHER THAN ONLY TRUSTED. If the profile were called something
# else, the line before the grant would show it, and `usermod` would name the replacement - which is
# exactly how the run above got from a wrong authorization name to this one.
# THIS SYSTEM HAS NO PACKAGE PROFILE TO GRANT, AND THE CONSOLE SAID SO IN TWO LINES.
#
# MEASURED on the 49e152e run, in the assumed root shell:
#
#	root@openindiana:~# grep -i package /etc/security/prof_attr
#	root@openindiana:~#                                   <- NO OUTPUT
#	root@openindiana:~# usermod -P +'Solaris Package Manager' vmuser
#	UX: usermod: ERROR: +Solaris Package Manager is not a valid profile name.  Choose another.
#
# AND `profiles` FOR THE ACCOUNT DID NOT GAIN IT EITHER:
#
#	Console User, Suspend To RAM, Suspend To Disk, Brightness, CPU Power Management,
#	Network Autoconf User, Basic Solaris User, All
#
# `Solaris Package Manager` IS A SOLARIS 11 PROFILE AND THIS IS NOT SOLARIS 11. OpenIndiana Hipster
# ships IPS without a profile named for it, so there is nothing to grant and no authorization name to
# append - the two previous attempts failed on exactly that, from opposite directions.
#
# SO THE PACKAGE OPERATION RUNS IN THE ROOT SHELL, WHICH IS THE ONE PLACE ON THIS SYSTEM IT IS
# PROVEN TO WORK. `su -` already succeeded and the prompt is `root@openindiana:~#`. Running `pkg`
# there is not a workaround - it is the privileged context this disk actually has.
#
# THE RISK IS THE RECORDING, NOT THE COMMAND: a 90-minute `pkg` run holds the console, so the step's
# own output is the only thing the log will show. That is acceptable here because `pkg` writes its
# progress to the terminal this step is typing into.
#
# AND THE PROOF MOVES TO WHERE IT BELONGS: `pkg` EXITS NON-ZERO IF IT COULD NOT INSTALL, and the
# desktop's own session file is then checked over ssh - which is a fact about the system rather than
# about a name in an authorization list.
#
# `mate_install` AND `lightdm`, NOT `solaris-desktop` AND `gdm`, AND THREE RUNS ARE WHAT SAID SO.
# OpenIndiana's own handbook, under "Installing OpenIndiana", gives the two commands this stage
# needs:
#
#	pkg install mate_install
#	svcadm enable -r /application/graphical-login/lightdm
#
# MATE IS THIS DISTRIBUTION'S DEFAULT DESKTOP; `solaris-desktop` is a Solaris 11 group with no
# equivalent here, and `gdm` is not the display manager it ships. MEASURED: three runs installed
# `solaris-desktop` successfully - `pkg` returned 0 - and `/usr/share/xsessions/gnome.desktop` was
# still absent afterwards, because nothing had been installed under that name at all.
#
# `-r` ON THE ENABLE IS NOT OPTIONAL: it restarts the service and the ones that depend on it, which is
# what makes lightdm actually come up rather than record that it should.
step "install the desktop in the root shell"
  input text "pkg install --accept --licenses mate_install; echo PKG_EXIT=$?"
  type_gap 0.05
  settle 3


step "run the install"
  input ret
  settle 10


# THE EXIT LINE IS WAITED FOR, NOT INSPECTED ONCE, AND THE FIRST RUN IS WHAT SAID SO.
#
# MEASURED on the run before this one: the console at t=255 - the last frame before the step was
# abandoned - still read
#
#	root@openindiana:~# pkg install --accept --licenses mate_install; echo PKG_EXIT=$?
#
# with the prompt still at the end of the line. The command had been TYPED and the Return had not
# taken effect yet, so a `check:` placed straight after it read the boot text still on the screen and
# answered `none of "PKG_EXIT=0" found`. A settle cannot fix that: how long `pkg` takes depends on the
# network, which is the whole reason it needs a budget rather than a pause.
#
# SO THIS IS A LOOP WITH A CEILING: it reads the screen until the line appears or ninety minutes pass.
# `PKG_EXIT=` IS THE RIGHT THING TO WAIT FOR because the shell prints it whatever `pkg` decided - the
# line appearing at all is "the command finished", and its VALUE is what the next step judges.
step "wait for the install to finish"
  repeat
    do
      item
        settle 20
      item "read the screen"
        read
          name after_pkg
    until
      bind done
      source after_pkg
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[PKG_EXIT]]
    max 270


step "the install reported success"
  check
    source after_pkg
    mode text
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [[PKG_EXIT=0]]
    name pkg_ok


step "prove the session is installed"
  ssh "ls -l /usr/share/xsessions/mate.desktop"
  timeout 120


# THE DISPLAY MANAGER IS ENABLED IN THE SAME ROOT SHELL, FOR THE SAME REASON THE INSTALL WAS.
# `pfexec svcadm enable` from vmuser's session is another command the account is not entitled to run -
# the 49e152e run showed `pfexec` reaching nothing it did not already own.
step "enable the display manager in the root shell"
  input text "svcadm enable -r svc:/application/graphical-login/lightdm:default; echo DM_EXIT=$?"
  type_gap 0.05
  settle 3


step "run the enable"
  input ret
  settle 10


step "the display manager reports online"
  ssh "svcs -H -o state svc:/application/graphical-login/lightdm:default"
  timeout 180


# A DISPLAY MANAGER THAT IS ONLINE AND A GNOME SESSION ARE TWO DIFFERENT FACTS, and this system is
# slow enough to reach the second one minutes after the first. The screen is the only thing that can
# tell them apart, so the walk looks at it - the same picture gate every other desktop wait here uses.
step "the desktop is on screen"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name screen
    until
      bind desktop
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [["Applications"]]
    max 60


step "flush the writes before anything else"
  ssh "sync"
  timeout 300


step "flush the writes before the machine stops"
  ssh "sync"
  timeout 300


# `stop ssh` RATHER THAN `stop power`: an ACPI power press asks the desktop to shut down, and a
# desktop that is still bringing itself up may ignore it for the whole timeout. `stop ssh` sends the
# command and tolerates the session ending with the machine, which is what `shutdown` does.
step "shut the machine down"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
