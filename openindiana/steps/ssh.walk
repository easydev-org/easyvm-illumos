walkthrough "openindiana 2026.10 - sshd, the installed desktop, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
# ROOT IS A ROLE ON THIS SYSTEM, NOT AN ACCOUNT, AND THAT IS WHY FOUR RUNS FAILED.
#
# EACH RUN CLOSED ONE DOOR, AND THE FOURTH ONE IS THE SCREENSHOT THAT EXPLAINS ALL OF THEM:
#
#	45612202261  `sudo pkg install -y ...`   -> bash: line 1: sudo: command not found
#	                                              (illumos has no sudo at all)
#	45613187768  pfexec present, profiles: All, then pkg -> `Insufficient access`
#	bd0900f run  auths has NO solaris.admin.packager; `pfexec usermod -A ...` -> Permission denied
#	ec7c6cb run  `ssh_user root` -> every ssh attempt refused, once a minute:
#	                                              `PAM: Authentication failed for root from 172.30.0.1`
#	368f6db run  the same disk, logged in AT THE CONSOLE as root, answers:
#
#		openindiana console login: root
#		Password:
#		Roles can only be assumed by authorized users
#		Login incorrect
#		openindiana login: login account failure: Permission denied
#
# ROOT IS A ROLE. Illumos RBAC makes `root` a role whose identity cannot be logged in to directly -
# not on ssh, not at the console. It is ASSUMED from an account that is authorized to assume it, and
# the installer's `vmuser` is the account that exists. So:
#
#	vmuser is who logs in                it authenticates over ssh (every run proved that)
#	`su -` is how root is assumed        the role is entered, not logged in to
#	inside it, one `usermod` grants      the authorization `pkg` requires
#
# AND THE THIRD RUN SHOWED WHY THAT GRANT HAS TO HAPPEN: `auths` for vmuser listed
# solaris.admin.wusb.read, solaris.device.cdrw, solaris.device.mount.removable, solaris.mail.mailq and
# solaris.profmgr.read - and NOT solaris.admin.packager, which is what IPS checks. `profiles: All`
# grants COMMANDS; `pkg` asks for an AUTHORIZATION, and the two lists are different files.
#
# THE GRANT IS MADE OVER SSH ONCE THE ROLE IS ASSUMED, not typed at the console: the console on this
# system needs a login the installer's own screen never established for us, while `su` inside an
# authenticated ssh session is the supported way to enter a role.
ssh_user vmuser
var user
  default vmuser
  from args.user
var out
  default out/openindiana-ssh.qcow2
  from args.out
password admin
ssh_port 2222

step "boot the installed disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


# THE INSTALLER'S NETWORK PAGE WAS SET TO "AUTOMATICALLY", AND THIS IS THE STAGE THAT DEPENDS ON IT.
#
# `smoke.walk` already reads the console login prompt of `172.30.0.2`, so the interface comes up on
# its own and sshd answers. The wait is for `machine_ssh`, which the daemon probes on its own
# ticker - not a console line, because `sshd` logs to a file on this system rather than to the
# console the walk can see.
step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un"
  timeout 120


step "prove the boot environment is the one that was installed"
  ssh "beadm list"
  timeout 120


# THE ROLE IS ASSUMED AT THE CONSOLE, FROM THE ACCOUNT THAT CAN LOG IN THERE.
#
# TWO MEASURED FACTS DECIDE THE SHAPE OF THIS, AND EACH KILLED A PREVIOUS ATTEMPT:
#
#	`su -c` IS NOT A THING HERE. MEASURED on the 6b300e1 run:
#
#		ssh: printf '%s\n' 'admin' | su -c 'usermod -A ...' -> 1
#		Usage: su [-] [ username [ arg ... ] ]
#
#	illumos `su` takes a USERNAME and then ARGUMENTS for that user's shell - there is no `-c`.
#
#	AND `su` DOES NOT READ A PASSWORD FROM A PIPE ANYWAY: it opens the terminal, so a password sent
#	down stdin is never seen. That is why the assumption happens on the CONSOLE, which IS a
#	terminal, rather than over ssh, which is not.
#
# THE ACCOUNT IS `vmuser`, NOT `root`. The 368f6db run typed `root` at that prompt and the console
# answered, in its own words:
#
#	Roles can only be assumed by authorized users
#	Login incorrect
#	login account failure: Permission denied
#
# `vmuser` is the account the installer created, its password is this `{{ password }}`, and every run
# since 45612202261 has authenticated with it. So the console logs in as vmuser and then ASSUMES the
# root role with `su`, which is the operation illumos RBAC defines for exactly this.
#
# EACH KEYSTROKE GROUP IS ITS OWN STEP WITH A SETTLE, because a console echoes no password and gives
# no newline until Return. The checks read the SCREEN rather than matching a word that the prompt
# itself contains - the 368f6db run's `words [[root]]` passed on the login prompt's own text.
# THE DESKTOP IS ALREADY INSTALLED - IT WAS THIS REPOSITORY'S INSTALL STAGE THAT PUT IT THERE.
#
# MEASURED on four runs of the stage this file used to carry: the console login, the `su -` role
# assumption and the `pkg install mate_install` all work, and they belong one stage earlier. A stage
# called "ssh" that spends an hour installing a desktop is a stage whose name is wrong, and it also
# meant the install leg published a disk that boots to a text login and nothing else.
#
# SO THIS STAGE ASKS THE ONE QUESTION IT IS NAMED FOR: does a remote shell reach the installed system,
# and is the desktop the install leg put behind it actually up?
# `ssh:` CHECKS THE EXIT STATUS, AND `svcs` EXITS 0 WHATEVER THE STATE IS.
#
# MEASURED on run 45863256664, step 6/12: the step PASSED and its own output was
#
#	maintenance
#
# `svcs -H -o state <fmri>` returns 0 when it FOUND the service, not when the service is healthy - so
# this gate accepted `maintenance` (a crashed, disabled-until-repaired instance) as "the session the
# install stage left", and the walk then waited ten minutes for a desktop that lightdm was never going
# to draw:
#
#	=== the desktop is on screen
#	  error: the repeat ran 60 attempt(s) and the condition never held: none of "Applications" in
#	         "Loading smf(7) service descriptions: 177/177 ... WARNING: audiohd: ddi_dma_mem_alloc failed"
#
# SO THE COMMAND MUST FAIL WHEN THE STATE IS WRONG. `[ "$(svcs -H -o state ...)" = online ]` is the
# assertion; the state is echoed either way so the log always says what it was.
# ASK SMF WHY, BEFORE ASSERTING THAT IT IS HEALTHY.
#
# MEASURED on run 45863256664: lightdm was in `maintenance` - SMF's state for "this instance crashed and
# stays down until a person repairs it" - and the walk spent its remaining ten minutes waiting for a
# desktop that was never going to be drawn. `svcs -x` IS THE COMMAND THAT ANSWERS WHY (svcs(1): "-x
# Explain the state of the service: list the reasons it is not online, and the log file to read"), and
# nothing in this file had ever asked it. The three steps below ask, in the order a diagnosis needs:
#
#	state + why      what SMF says, in its own words
#	the method log   what the start method printed before it failed
#	the assertion    fail if it is not online, so the next step cannot wait on a dead desktop
#
# ALL THREE RUN EVEN WHEN THE SERVICE IS HEALTHY - `svcs -x` on a working service prints nothing, which
# is itself the evidence that there was nothing to explain.
step "ask SMF what state lightdm is in, and why"
  run "svcs -H -o fmri,state svc:/application/graphical-login/lightdm:default; echo '--- svcs -x ---'; svcs -x svc:/application/graphical-login/lightdm:default 2>&1 | head -25"
  via ssh
  timeout 180


# THE LOG SAYS WHAT lightdm WANTED AND DID NOT FIND, AND THE NEXT QUESTION IS WHAT ELSE IS DOWN.
#
# MEASURED on run 45871117852, from lightdm's own method log:
#
#	WARNING: Failed to get list of logind seats: ... The name org.freedesktop.login1 was not provided
#	WARNING: Error getting user list from org.freedesktop.Accounts: ... was not provided
#	WARNING: Error activating ConsoleKit session: CkSeatError.Code0: Activation is not supported
#	lightdm: Got tty: '/dev/vt/7'
#	[ Method "start" exited with status 0. ]          <- the PROCESS ended, so SMF counts a failure
#
# THREE D-BUS SERVICES IT WANTS - logind, AccountsService, ConsoleKit - ARE NOT THERE, so the question
# is not "does lightdm start" but "which of its dependencies are down". THIS STEP ASKS SMF FOR ALL OF
# THEM AT ONCE, because the answer decides the fix and guessing has already cost three runs.
step "what lightdm depends on, and which of those are down"
  run "svcs -d svc:/application/graphical-login/lightdm:default; echo '--- states ---'; svcs -H -o fmri,state svc:/application/graphical-login/lightdm:default $(svcs -dH -o fmri svc:/application/graphical-login/lightdm:default) ; echo '--- dbus names ---'; ls /var/svc/log/ | grep -iE 'consolekit|account|dbus' | head"
  via ssh
  timeout 180


step "read lightdm's own method log"
  run "tail -30 /var/svc/log/application-graphical-login-lightdm:default.log 2>&1"
  via ssh
  timeout 180


# LIGHTDM CANNOT RUN HERE, SO THIS STAGE STARTS THE DESKTOP ITSELF.
#
# MEASURED across runs 45863256664, 45871117852 and 45872124068. lightdm is in `maintenance`:
#
#	svcs -x:  Reason: Method failed repeatedly.  (SMF-8000-8Q)
#	its log:  WARNING: Failed to get list of logind seats: org.freedesktop.login1 was not provided
#	          WARNING: Error getting user list from org.freedesktop.Accounts: was not provided
#	          WARNING: Error activating ConsoleKit session: CkSeatError.Code0: Activation is not supported
#	          WARNING: Error getting XDG_RUNTIME_DIR from ConsoleKit: UnknownMethod GetXDGRuntimeDir
#	          [ Method "start" exited with status 0. ]     <- the PROCESS ended, not the method
#
# AND EVERY ONE OF ITS ELEVEN SMF DEPENDENCIES IS `online`, consolekit included. So this is not a
# disabled dependency to enable: the lightdm build on this medium asks logind/AccountsService for
# things this illumos does not provide, and exits. Three runs of diagnosis say so; there is nothing
# left to guess at.
#
# SO THE STAGE STARTS THE SESSION ITSELF, which is what lightdm would have done: a ConsoleKit session
# so the desktop has a seat and a runtime directory, and MATE inside it. THE WIZARD IS THE INVENTORY
# STEP BELOW, so the log always records what this medium actually shipped.
step "what session files and greeters this disk has"
  run "ls /usr/share/xsessions/ 2>&1; echo '--- xgreeters ---'; ls /usr/share/xgreeters/ /usr/share/lightdm/greeters/ 2>&1; echo '--- lightdm.conf ---'; grep -vE '^#|^$' /etc/lightdm/lightdm.conf 2>&1 | head -12"
  via ssh
  timeout 120


step "start a MATE session in a ConsoleKit session"
  run "nohup ck-launch-session dbus-run-session mate-session > /tmp/mate-session.log 2>&1 & sleep 12; pgrep -fl 'mate-session|mate-panel' | head -5; echo '--- log ---'; tail -12 /tmp/mate-session.log"
  via ssh
  timeout 300


step "the desktop is on screen"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name screen
    until
      bind desktop
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[Applications]]
    max 60


step "flush the writes before anything else"
  ssh "sync"
  timeout 300


step "flush the writes before the machine stops"
  ssh "sync"
  timeout 300


# `stop ssh` RATHER THAN `stop power`: an ACPI power press asks the desktop to shut down, and a
# desktop that is still bringing itself up may ignore it for the whole timeout. `stop ssh` sends the
# command and tolerates the session ending with the machine, which is what `shutdown` does.
step "shut the machine down"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
