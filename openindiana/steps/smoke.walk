# DOES THE PUBLISHED DISK START? Boot it, look, and kill it - nothing else.
#
# "THE INSTALL LEG PASSED" IS NOT THE SAME CLAIM. An install can answer every one of its steps and
# still publish a disk no firmware will boot - MEASURED on android blissos 16.9.7, whose install ended
# with "Congratulations!" and whose disk printed
#
#	BdsDxe: failed to load Boot0002 "UEFI QEMU HARDDISK QM00011" ... : Not Found
#
# so this file asks only whether the machine gets off the ground. It does not log in and does not
# click; its artifact is the recording. `stage.yml` runs it with `out:` empty, which is what makes
# "no disk to publish" a success rather than a warning.
#
# THE BOOT ARGUMENTS ARE THE INSTALL WALK'S, DELIBERATELY - same machine, same firmware, the target
# disk at bootindex=0 with `discard=unmap`, no installer medium - because a smoke test that boots a
# different machine from the one the next stage does is measuring itself rather than the artifact.
#
# OPENINDIANA'S INSTALLED DISK IS STARTED BY ITS OWN LOADER, NOT BY THE FIRMWARE'S ESP ENTRY.
#
# THE COMMENT THAT USED TO STAND HERE CLAIMED THE OPPOSITE - that the 2026.10 image "carries UEFI
# framebuffer support" and that an installed rpool is started by the firmware's own loader, so
# `BdsDxe: starting` was the witness to wait for. MEASURED on the pod, 2026-11-23, on a disk this very
# install produced: the firmware prints nothing at all about a bootable device, and the console goes
#
#	Loading unix...
#	Loading /platform/i86pc/amd64/boot_archive...
#	Booting...
#	OpenIndiana Hipster 2026.10 Version illumos-c893fd03ad 64-bit
#	openindiana console login:
#
# - the illumos boot loader in the disk's own boot slice, which is what the installer writes on the
# whole-disk EFI layout. So `BdsDxe` would never appear and waiting for it would time out on a disk
# that boots perfectly.
#
# THE WITNESS IS THEREFORE THE LOGIN PROMPT, which is a stronger claim than any firmware message: it
# means the kernel mounted rpool, started svc:/system/console-login, and the system is up. MEASURED
# at about two and a half minutes from `boot`.
#
# THE SSH LINE IS A BONUS AND NOT A CONDITION. The same console showed
#
#	openindiana sshd-session[1379]: error: PAM: Authentication failed for user vmuser from 172.30.0.1
#
# - the daemon's own probe reaching sshd through the guest's DHCP address, which is how the next stage
# logs in. It arrives a few seconds after the prompt and in a different order on a slow runner, so it
# is not what this waits for.
walkthrough "the published disk starts - nothing else"
resolution 1920x1080
recording_resolution 1920x1080

step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 300

# `BdsDxe: starting` IS THE FIRMWARE SAYING IT FOUND SOMETHING BOOTABLE, and a disk it cannot start
# prints the opposite sentence on the same console. That is the difference between a boot and a black
# screen, and it is a better witness than any brightness threshold.
step "the installed system is up"
  until "console login"
  from console
  timeout 600


step "record three minutes of the boot"
  settle 180

step "stop the machine"
  stop kill
  timeout 120
