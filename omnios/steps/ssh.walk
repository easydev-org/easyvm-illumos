# OMN IOS r151060 - the administrator gets in, and the server proves it is a server.
#
# READ `omnios/steps/install.walk` FIRST. ITS SEVEN PAGES ARE ALL THE INSTALLER ASKS, AND NONE OF THEM
# IS A ROOT PASSWORD - measured, and that file lists every page. So the disk it publishes has an
# `rpool` that boots and a root account whose password NOBODY SET.
#
# THAT IS WHAT THIS STAGE FIXES, AND IT FIXES IT THE ONLY WAY AN UNATTENDED WALK CAN: from the loader's
# own single-user mode, which skips the login that has no password.
#
# THE LOADER MENU CLEARS ITSELF ON A FOUR SECOND AUTOBOOT - the install file says so in its own words -
# so this walk starts pressing as soon as the machine is up, waits for the menu, and takes the
# single-user entry. `-s` is illumos' own spelling for it, the same as Solaris'.
#
# ONCE IN, THREE THINGS ARE TRUE THAT WERE NOT:
#
#	root gets a password                 `passwd -r files root`, twice, so a console login works
#	sshd is enabled                      OmniOS ships `svc:/network/ssh:default` disabled
#	root may log in over the network     `PermitRootLogin yes`, because the console is not the network
#
# AND THE INTERFACE IS CONFIGURED, because the installer's own network menu does not touch the disk:
# `ipadm create-addr -T dhcp net0/v4`.
#
# NOTHING IS CONFIGURED OVER SSH UNTIL IT ANSWERS. Every one of those four is a console keystroke, and
# `wait for sshd` is the first thing that uses the network at all - the reverse order is the deadlock
# `midnightbsd` was stuck in.
#
# NO DESKTOP, AND THAT IS THE DISTRIBUTION: `README.md` records the measurement - OmniOS's core and
# extra repositories hold 1109 packages between them and NONE of the desktop names, no mate, no xfce,
# no lightdm, no slim. So the last acts are `sync`, a clean shutdown, and `wait_until stopped`.
walkthrough "omnios r151060 - single user, a root password, sshd, and a server that answers"
resolution 1024x768
recording_resolution 1024x768
var out
  default out/omnios-ssh.qcow2
  from args.out
password admin
user root
var user
  default root
  from args.user
ssh_port 2222


step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:04,romfile=,host_mtu=1450"]]
    timeout 900


# THE MENU IS GONE IN FOUR SECONDS, so Escape is sent immediately and repeatedly until the loader's
# own prompt answers. `esc` at the loader stops the countdown; `-s` is then typed at the prompt.
# THE MENU IS WAITED FOR, NOT INTERRUPTED. `esc` WAS ESCAPING TO A SHELL, NOT STOPPING A COUNTDOWN.
#
# Three earlier commits sent `esc` immediately after boot, believing it stopped an autoboot. The menu
# this release draws is already on screen by then (measured: frame 4 of run 45956253734), and `esc` on
# that menu selects ROW 3 - `[Esc]ape to loader prompt` - which is a different state from the row list
# this stage now uses.
#
# SO NOTHING IS PRESSED HERE. The menu's own words are waited for, and the step after this one takes
# row 2.
# THE MENU IS PRESSED AT, REPEATEDLY, BECAUSE `spc` ONCE ARRIVES BEFORE THE MENU IS DRAWN.
#
# MEASURED on run 45959110119 - the commit that added `spc`. Its own key log is:
#
#	=== pause the countdown and take row 2 in the same breath
#	  key spc
#	  typed 1 character(s)
#	  key ret
#
# and the frame after it was a NORMAL BOOT: `OmniOS r151060 Version omnios-r151060-513bc64de92 64-bit`.
# `boot:` returns as soon as qemu is up, which is BEFORE OmniOS has drawn its menu, so the three keys
# went into a blank screen and the countdown took row 1 as if nothing had been sent.
#
# THE RECORDING OF THE SAME DISK SHOWS HOW LONG THE WINDOW IS: at t=5s the footer reads
# `Autoboot in 7 seconds. [Space] to pause`, so the menu is up and waiting for roughly ten seconds.
#
# SO THE KEYS ARE REPEATED UNTIL THE MENU IS GONE, rather than sent once at an unknown moment:
#
#	read the screen
#	2, ret          row 2 is `Boot Single User`; a `2` typed before the menu arrives is harmless
#	until the words "Boot"/"Multi"/"User" are absent
#
# ONCE THE MENU IS PAST, THE SAME KEYS ARE INERT: `2` and Return at the single-user shell produce a
# line the shell rejects, which is why the gate after this one reads for a prompt rather than trusting
# that nothing was typed.
step "take row 2, retrying until the menu is gone"
  repeat
    do
      item "read the screen"
        read
          name menu
      item "type the row number"
        input text "2"
        settle 1
      item "take it"
        input ret
        settle 6
    until
      bind gone
      source menu
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      without [Multi, User, Autoboot]
    max 25


step "the single-user shell is up"
  repeat
    do
      item
        settle 5
      item "read the console"
        read
          name su
    until
      bind up
      source su
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[#], [single, user]]
    max 60


step "put root's password on the disk, twice"
  input text "passwd -r files {{ user }}"
  settle 3


step "run it"
  input ret
  settle 5


step "the new password"
  input text "{{ password }}"
  settle 2


step "take it"
  input ret
  settle 4


step "the repeat"
  input text "{{ password }}"
  settle 2


step "take the repeat"
  input ret
  settle 6


# THE SERVICE IS NAMED BY THE SYSTEM, NOT ASSUMED HERE - a guessed FMRI fails silently in a console.
step "what the system calls its ssh service"
  input text "svcs -a | grep -i ssh"
  settle 3


step "run it"
  input ret
  settle 6


step "enable sshd, by the name the system just reported"
  input text "svcs -a | grep -i ssh | awk '{print $2}' | while read f; do svcadm enable -s $f; done; svcs -H -o fmri,state 2>/dev/null | grep -i ssh"
  settle 3


step "run it"
  input ret
  settle 8


step "let root log in over the network, which is not the console"
  input text "sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config; grep -c '^PermitRootLogin yes' /etc/ssh/sshd_config"
  settle 3


step "run it"
  input ret
  settle 6


# THE INTERFACE IS NAMED BY THE SYSTEM, NOT ASSUMED HERE.
#
# `net0` IS A SOLARIS-ON-X86 NAME AND THIS GUEST MAY NOT HAVE ONE. The disk is booted with
# `virtio-net-pci`, whose illumos driver makes `vioif0`, and OmniOS runs NWAM by default - so the
# console is asked first and the answer is what the next command uses.
step "what the system calls the interface, and whether it already has an address"
  input text "dladm show-link; echo ---; ipadm show-if; echo ---; ipadm show-addr"
  settle 3


step "run it"
  input ret
  settle 12


step "give the interface an address, which the installer configured nothing for"
  input text "L=$(dladm show-link -p -o link | head -1); echo LINK=$L; ipadm create-if $L 2>/dev/null; ipadm create-addr -T dhcp $L/v4 2>/dev/null || ipadm create-addr -T dhcp $L/v4 2>&1; sleep 5; ipadm show-addr"
  settle 3


step "run it"
  input ret
  settle 25


# NO REBOOT, AND THAT IS A MEASUREMENT RATHER THAN A SHORTCUT.
#
# `174ff00` AND `d26abd0` BOTH REBOOTED HERE, AND THAT IS WHAT THREW THE ADDRESS AWAY. `ipadm
# create-addr` ADDS AN ADDRESS TO THE RUNNING SYSTEM; IT IS NOT A PERSISTENT CONFIGURATION. A reboot
# therefore comes back with the interface unconfigured - and the boot menu the earlier commits were
# fighting is a symptom of the same mistake: the walk was restarting a machine it had just prepared.
#
# NOTHING HERE NEEDS A REBOOT. `svcadm enable` and `svc:/network/ssh` survive it anyway, `passwd -r
# files` wrote to the disk, and the address is wanted for THIS boot so that `wait for sshd` can reach
# it. So the walk goes straight from the console commands to the wait, and the only thing on the
# network is the one thing that needs it.
step "flush the writes, then wait for sshd on the address just configured"
  input text "sync"
  settle 2


step "run it"
  input ret
  settle 4


step "wait for sshd"
  repeat
    until machine_ssh
    max 120
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"


step "prove the account over ssh"
  ssh "id -un"


step "prove the root pool is the one that was installed"
  ssh "zpool list -H -o name,health"


step "prove sshd is the service that answered"
  ssh "svcs -H -o state svc:/network/ssh:default"


step "flush the writes before the machine stops"
  ssh "sync"


step "shut the machine down"
  ssh "shutdown -i 0 -g 0 -y"


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
