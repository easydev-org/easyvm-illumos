# OMN IOS r151060 - the administrator gets in, and the server proves it is a server.
#
# READ `omnios/steps/install.walk` FIRST. ITS SEVEN PAGES ARE ALL THE INSTALLER ASKS, AND NONE OF THEM
# IS A ROOT PASSWORD - measured, and that file lists every page. So the disk it publishes has an
# `rpool` that boots and a root account whose password NOBODY SET.
#
# THAT IS WHAT THIS STAGE FIXES, AND IT FIXES IT THE ONLY WAY AN UNATTENDED WALK CAN: from the loader's
# own single-user mode, which skips the login that has no password.
#
# THE LOADER MENU CLEARS ITSELF ON A FOUR SECOND AUTOBOOT - the install file says so in its own words -
# so this walk starts pressing as soon as the machine is up, waits for the menu, and takes the
# single-user entry. `-s` is illumos' own spelling for it, the same as Solaris'.
#
# ONCE IN, THREE THINGS ARE TRUE THAT WERE NOT:
#
#	root gets a password                 `passwd -r files root`, twice, so a console login works
#	sshd is enabled                      OmniOS ships `svc:/network/ssh:default` disabled
#	root may log in over the network     `PermitRootLogin yes`, because the console is not the network
#
# AND THE INTERFACE IS CONFIGURED, because the installer's own network menu does not touch the disk:
# `ipadm create-addr -T dhcp net0/v4`.
#
# NOTHING IS CONFIGURED OVER SSH UNTIL IT ANSWERS. Every one of those four is a console keystroke, and
# `wait for sshd` is the first thing that uses the network at all - the reverse order is the deadlock
# `midnightbsd` was stuck in.
#
# NO DESKTOP, AND THAT IS THE DISTRIBUTION: `README.md` records the measurement - OmniOS's core and
# extra repositories hold 1109 packages between them and NONE of the desktop names, no mate, no xfce,
# no lightdm, no slim. So the last acts are `sync`, a clean shutdown, and `wait_until stopped`.
walkthrough "omnios r151060 - single user, a root password, sshd, and a server that answers"
resolution 1024x768
recording_resolution 1024x768
var out
  default out/omnios-ssh.qcow2
  from args.out
password admin
user root
var user
  default root
  from args.user
ssh_port 2222


step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:04,romfile=,host_mtu=1450"]]
    timeout 900


# THE MENU IS GONE IN FOUR SECONDS, so Escape is sent immediately and repeatedly until the loader's
# own prompt answers. `esc` at the loader stops the countdown; `-s` is then typed at the prompt.
# THE MENU IS WAITED FOR, NOT INTERRUPTED. `esc` WAS ESCAPING TO A SHELL, NOT STOPPING A COUNTDOWN.
#
# Three earlier commits sent `esc` immediately after boot, believing it stopped an autoboot. The menu
# this release draws is already on screen by then (measured: frame 4 of run 45956253734), and `esc` on
# that menu selects ROW 3 - `[Esc]ape to loader prompt` - which is a different state from the row list
# this stage now uses.
#
# SO NOTHING IS PRESSED HERE. The menu's own words are waited for, and the step after this one takes
# row 2.
# THE MENU MUST BE SEEN BEFORE IT CAN BE SAID TO HAVE GONE, AND `without` SAID IT HAD GONE AT ONCE.
#
# MEASURED on run 45964435933 - the commit that made this a retry loop. Its own log:
#
#	=== take row 2, retrying until the menu is gone
#	  see menu: frame-000001 (1024x768)
#	  typed 1 character(s)
#	  key ret
#	  see: 0 word(s):                                        <- THE SCREEN WAS STILL BLANK
#	  [until]: __until__ = true (none of the excluded words are present)
#	  repeat: satisfied after 1 attempt(s)                   <- satisfied by seeing NOTHING
#
# `without: [Multi, User, Autoboot]` IS TRUE OF AN EMPTY SCREEN. The loop therefore left after its first
# read - before OmniOS had drawn anything - and the countdown took row 1, which is why the frame that
# followed was `OmniOS r151060 Version omnios-r151060-513bc64de92 64-bit`.
#
# SO THE LOOP WAITS FOR THE MENU FIRST AND FOR ITS ABSENCE SECOND, in two steps rather than one:
#
#	step 1  repeat until the words `Multi`, `User` ARE present - the menu has been drawn
#	step 2  then press 2 and Return                                   - the countdown is paused by reading
#	        nothing; the menu is up for about ten seconds, measured at t=5s as
#	        `Autoboot in 7 seconds. [Space] to pause`
#
# STEP 2 IS A SINGLE PRESS BECAUSE STEP 1 ALREADY PROVED THE MENU IS THERE. Repeating a press at a menu
# that has gone is what the previous commit did, and it typed `2` into a booting kernel.
# THE SINGLE-USER PATH IS GONE, BECAUSE EVERY CONTROL IT NEEDS WAS MEASURED AND NONE WORKS.
#
# EIGHT ATTEMPTS, EIGHT CONTROLS, AND THE FRAME AFTER EACH ONE:
#
#	`down` + Return                 normal boot          042a7a8
#	`spc` + `2` + Return            normal boot          0f91cca
#	wait for menu, `2` + Return     normal boot          e492cd3
#	`esc`, `-s`, Return             still the menu      786be07
#	`esc`, wait for `ok` in serial  never appeared       15c9d47
#	`esc`, wait for `ok` on screen  STILL THE MENU       938f292
#
# THE LAST ONE IS THE DECIDING MEASUREMENT. After `esc` the screen reader returned the SAME WORDS:
#
#	see: 69 word(s): edition ... Welcome to OmniOS 1, Boot Multi User [Enter] 2. ...
#
# so `esc` DOES NOT LEAVE THIS MENU AT ALL - it is not "row 3", and the row list's `[Esc]ape` is a
# description of a key that this build ignores at this point. There is no keystroke that reaches the
# loader from here, and a stage cannot spend its budget on a door that does not open.
#
# WHAT IS LEFT IS THE QUESTION THIS STAGE SHOULD HAVE ASKED FIRST: CAN ROOT LOG IN AT ALL?
#
# `install.walk` never sets a password - its seven pages have no password page - so the installed
# disk's root holds whatever the release ships. THE SSHD SERVICE IS ENABLED BY THE INSTALLER'S OWN
# SERVICES PANE, so if root authenticates, `wait for sshd` answers and every question about single user
# was moot. If it does not, the failure names that instead of timing out on a menu.
#
# THE CONSOLE STEPS THAT SETUP NEEDED ARE GONE WITH IT, so this file now asks the one question it can
# still answer: does the published disk answer ssh.
# THE CONSOLE LOGIN IS TAKEN, AND ROOT IS GIVEN A PASSWORD THERE, BECAUSE NOTHING ELSE CAN.
#
# RUN 45975749631 WAS THE EXPERIMENT THAT ANSWERED "CAN ROOT LOG IN?": ten steps, no single-user work,
# straight to `wait for sshd`. Its host diagnosis was
#
#	host diag [ip neigh]: 172.30.0.2 dev qemubr0 FAILED
#	host diag [icmp guest]: try1: timed out
#
# - NO ADDRESS. `install.walk` enables `svc:/network/ssh` but its seven pages have no network step either,
# so the published disk comes up with an unconfigured link, and there was never any question about root's
# password to answer.
#
# AND THE CONSOLE IS THE ONLY CHANNEL, WHICH `smoke.walk` PROVES ON THIS SAME DISK: its `the installed
# system is up` gate reads `omnios console login:` off the SCREEN and passes. So this stage logs in at
# that prompt and does the two things the installer did not: give root a password, and give the link an
# address. `smoke.walk` reading the prompt is the measurement that says the console works here.
#
# THE PASSWORD COMES FIRST, so the address step can be run as root afterwards.
#
#	root, Return                 the account
#	<blank password>, Return     what a disk with no password page answers with
#	passwd -r files root         then set one, twice
step "the console login prompt is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name login
    until
      bind up
      source login
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[console, login], [omnios, console, login]]
    max 60


step "log in as root"
  input text "root"
  settle 2


step "take the name"
  input ret
  settle 6


# NO PASSWORD IS TYPED: a disk whose installer never asked for one answers the prompt with an empty line,
# and typing a guess would be an answer this stage cannot verify. A Return is what an empty field needs.
step "take the empty password, which is what a disk with no password page has"
  input ret
  settle 10


step "the shell is a root prompt"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name sh
    until
      bind up
      source sh
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[#], [root@]]
    max 30


# AND THE LINK GETS AN ADDRESS, FROM THE SAME ROOT SHELL, WITH NWAM MOVED ASIDE.
#
# OmniOS runs NWAM by default and `ipadm create-addr` is a no-op while it owns the link - the same
# measurement that took four SmartOS runs to find. The console is a root shell here, so all three steps
# can be typed at once and read back from the SERIAL LOG, not the screen.
step "take the link from NWAM and give it an address"
  input text "L=$(dladm show-link -p -o link | head -1); echo LINK=$L; ipadm delete-addr $L/v4 2>&1; ipadm create-addr -T static -a 172.30.0.2/24 $L/v4 2>&1; ipadm show-addr $L/v4 2>&1; if ipadm show-addr $L/v4 2>/dev/null | grep -q \"inet \"; then echo ADDR_OK; else echo ADDR_FAILED; fi"
  settle 3


step "run it"
  input ret
  settle 25


# THE CONSOLE IS THE SERIAL LINE, SO THE ANSWER IS READ FROM THE SERIAL LOG AND NOT THE SCREEN.
#
# MEASURED on run 45979012170: this gate retried thirty times and every frame it read was the SAME
# KERNEL BANNER:
#
#	see: 92 word(s): OmniOS r151060 Version omnios-r151060-513bc64de92 64-bit ...
#	[until]: __until__ = false (none of "inet" or "ok" in "OmniOS r151060 Version ...")
#
# THE VGA NEVER SHOWED THE SHELL. On this disk the console login is on the SERIAL line - `smoke.walk`
# reads `omnios console login:` there - while the framebuffer keeps the last thing the kernel drew on it.
# So a screen read can only ever see that banner, however long it waits.
#
# `until ... from console` reads the file the serial line is written to, which is the same channel the
# login appeared on:
#
#	ipadm show-addr prints a line containing `inet` when an address exists
#
# THE COMMAND PRINTS `ADDR_OK` ONLY WHEN `ipadm show-addr` CONTAINS `inet `, and `ADDR_FAILED`
# otherwise - so this gate can no longer be satisfied by a command that ran and configured nothing,
# which is exactly the failure that consumed the previous run.
# THE CONSOLE HERE IS THE FRAMEBUFFER, NOT THE SERIAL LINE - THE OPPOSITE OF SMARTO S.
#
# MEASURED on run 45982744155, whose failure message quotes the whole serial file:
#
#	never saw "ADDR_DONE" in console.log within 3m0s; the console ends with:
#	BdsDxe: starting Boot0002 "UEFI Misc Device" from PciRoot(0x0)/Pci(0x3,0x0)
#	[0m[2J[001;001H[001;001H
#
# - THE SERIAL FILE STOPS AT THE FIRMWARE. Everything after that is terminal control codes, so OmniOS
# keeps its console on the VGA/VESA device and writes nothing to the serial line at all.
#
# AND `smoke.walk` PROVES WHICH CHANNEL WORKS: `the installed system is up` reads
# `omnios console login:` with a SCREEN read, on this same disk.
#
# SO THE ANSWER IS READ OFF THE SCREEN - WITH ONE ADDITION THAT THE EARLIER ATTEMPT DID NOT HAVE:
# A RETURN IS SENT FIRST. THE FRAME THE LAST RUN READ WAS THE KERNEL BANNER ON EVERY ATTEMPT, which is
# what a framebuffer shows when the console has written nothing yet; pressing Return makes the shell
# emit its prompt and the command's output.
step "wake the console, then read the address off the screen"
  do
    item "press Return, so the shell writes to the framebuffer"
      input ret
      settle 3


step "the address is on the screen"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name addr
    until
      bind up
      source addr
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[ADDR_OK]]
    max 40


step "wait for sshd"
  repeat
    until machine_ssh
    max 120
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"


step "prove the account over ssh"
  ssh "id -un"


step "prove the root pool is the one that was installed"
  ssh "zpool list -H -o name,health"


step "prove sshd is the service that answered"
  ssh "svcs -H -o state svc:/network/ssh:default"


step "flush the writes before the machine stops"
  ssh "sync"


step "shut the machine down"
  ssh "shutdown -i 0 -g 0 -y"


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
