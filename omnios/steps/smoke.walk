# DOES THE PUBLISHED DISK START? Boot it, look, and kill it - nothing else.
#
# "THE INSTALL LEG PASSED" IS NOT THE SAME CLAIM. An install can answer every one of its steps and
# still publish a disk no firmware will boot - MEASURED on this very guest, twice:
#
#	1  killed while `Installing ZFS image` read 100%    -> the disk's loader answered
#	       No rootfs module provided, aborting
#	       ok
#	2  killed before `Updating boot archive` appeared   -> same
#
# so this file asks only whether the machine gets off the ground. It does not log in and does not
# click; its artifact is the recording. `stage.yml` runs it with `out:` empty, which is what makes
# "no disk to publish" a success rather than a warning.
#
# THE BOOT ARGUMENTS ARE THE INSTALL WALK'S, DELIBERATELY - same machine, same firmware, the target
# disk at bootindex=0 with `discard=unmap`, no installer medium - because a smoke test that boots a
# different machine from the one the next stage does is measuring itself rather than the artifact.
#
# OMNIO S'S INSTALLED DISK IS STARTED BY ITS OWN LOADER, NOT BY A FIRMWARE ESP ENTRY, and its console
# STAYS ON THE SERIAL LINE. MEASURED on the pod, 2026-11-25, on a disk this install produced:
#
#	OmniOS r151060 Version omnios-r151060-513bc64de92 64-bit
#	Copyright (c) 2012-2017 Omni11 Computer Consulting, Inc.
#	Copyright (c) 2017-2026 OmniOS Community Edition (OmniOSce) Association.
#	Configuring devices.
#	Hostname: omnios
#	Applying initial boot settings...
#	omnios console login:
#
# - about ninety seconds from `boot`. Unlike OpenIndiana, where the kernel hands the console to the
# framebuffer and the serial line stops at `Booting...`, OmniOS keeps writing to the serial console
# AND to the 1024x768 VGA. Both are read here, so a run is not lost to whichever path the firmware
# chose on the day.
#
# THE LOGIN PROMPT IS THE WITNESS, and it is a stronger claim than any firmware message: it means the
# kernel mounted rpool, started the console login service, and the system is up.
walkthrough "the published disk starts - nothing else"
resolution 1024x768
recording_resolution 1024x768

step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"]]
    timeout 300


step "the installed system is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name up
    until
      bind login
      source up
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[console, login], [omnios, console, login]]
    max 60


step "record three minutes of the boot"
  settle 180


step "stop the machine"
  stop kill
  timeout 120
