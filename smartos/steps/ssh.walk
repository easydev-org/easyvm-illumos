# SMARTOS 20261121 - sshd, and the platform image the install left behind.
#
# THIS IS THE STAGE THE INSTALL LEG CANNOT ANSWER: does the published disk reach a shell over the
# NETWORK? `smoke.walk` proves the console login, which is a different claim.
#
# ROOT IS A REAL ACCOUNT HERE, AND ITS PASSWORD IS THE ANSWER FILE'S. `smartos/media/answers.json`
# carries `"root_password": "admin"`, the installer applies it, and `install.walk` logs in with it at
# the console after the reboot - so this stage does not have to invent one. THAT IS THE SAME HOOK
# `install.walk` USES, and reusing it is why this file has no password-setting step.
#
# SSHD IS NOT ENABLED BY THE INSTALLER. SmartOS ships `svc:/network/ssh:default` disabled on a fresh
# platform image, so the first half of this walk is a CONSOLE session that enables it - the network is
# what ssh needs, so that half cannot be done over ssh.
#
# THE CONSOLE IS `/dev/term/b` ON THIS GUEST (the smoke gate's own words), which is why the VGA device
# stays 1024x768 and the reads below use that rectangle: a larger framebuffer changes nothing the walk
# looks at, and the serial line is the one that carries the login prompt.
walkthrough "smartos 20261121 - sshd, and the platform image the install left behind"
resolution 1024x768
recording_resolution 1024x768
var out
  default out/smartos-ssh.qcow2
  from args.out
password admin
user root
var user
  default root
  from args.user
ssh_port 2222


step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "6144"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-chardev", "socket,id=qga1,path=qga1.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga1,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1024,yres=768"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:04,romfile=,host_mtu=1450"]]
    timeout 900


# SMARTOS SHOWS ITS OWN BOOT MENU FIRST, AND NOTHING LOGS IN UNTIL ROW 1 IS TAKEN.
#
# MEASURED on run 45947993748, step 2/25 - the console gate read this for its whole budget:
#
#	1. Boot SmartOS [Enter]   2. Escape to loader prompt   3. Reboot Options
#
# `smoke.walk` passes the same menu because its budget is four minutes and the menu eventually times
# out on its own; a stage that wants to be quick should take row 1 instead of waiting for it.
#
# A RETURN IS SENT FIRST, TWICE - the menu can be redrawn after the loader hands over - and the login
# wait follows. On a guest that is already past the menu the keystroke lands harmlessly.
step "take row 1 at SmartOS's own boot menu"
  input ret
  settle 15


step "and again, if the menu asked twice"
  input ret
  settle 15


step "the console login prompt is up"
  repeat
    do
      item
        settle 15
      item "read the console"
        read
          name login
    until
      bind up
      source login
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[uscons, login], [login:]]
    # SMOKE MEASURED THIS AT ROUGH SIXTY ROUNDS OF FIFTEEN SECONDS, and its own budget is 90. This
    # stage gave it 60, which is shorter than the thing it is waiting for - so it now matches smoke.
    max 90


step "log in at the console as root"
  input text "{{ user }}"
  settle 2


step "take the login name"
  input ret
  settle 6


step "type root's password, which the answer file set"
  input text "{{ password }}"
  settle 2


step "take the password"
  input ret
  settle 8


step "the shell is a root prompt"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name sh
    until
      bind up
      source sh
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      without [password]
      words [[root@], [#]]
    max 30


# THE SERVICE IS NAMED BY SMARTO S, NOT ASSUMED HERE.
#
# MEASURED on run 45950879868: the console login WORKED - `[until]: __until__ = true (read "root@")` -
# and the host reported `ssh_ready="false" present=true`, so the machine was on the network with sshd
# not answering. `svcadm enable svc:/network/ssh:default` was typed, and guessing the FMRI is the one
# thing this stage cannot afford: a service that does not exist fails silently in a console.
#
# SO THE CONSOLE IS ASKED WHICH ssh SERVICE EXISTS, and the answer is printed for the next reader:
step "what the system calls its ssh service"
  input text "svcs -a | grep -i ssh"
  settle 3


step "run it"
  input ret
  settle 6


step "enable sshd, by the name the system just reported"
  input text "svcs -a | grep -i ssh | awk '{print $2}' | while read f; do svcadm enable -s $f; done; svcs -a | grep -i ssh; echo ---; svcs -H -o fmri,state 2>/dev/null | grep -i ssh"
  settle 3


step "run it"
  input ret
  settle 8


step "allow root to log in over the network, which is not the console"
  input text "sed -i '' 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config; grep -c '^PermitRootLogin yes' /etc/ssh/sshd_config"
  settle 3


step "run it"
  input ret
  settle 8


step "restart sshd so the directive is read"
  input text "svcadm restart svc:/network/ssh:default"
  settle 3


step "run it"
  input ret
  settle 10


# THE ADDRESS COMES FROM NWAM, WHICH THIS DISK WAS INSTALLED TO USE - NOT FROM `ipadm` HERE.
#
# `smartos/media/answers.json` ALREADY SAID WHAT THIS STAGE WAS TRYING TO SAY:
#
#	"admin_mac": "52:54:00:56:4d:04",
#	"admin_ip":  "dhcp",
#
# and that is the MAC this walk's own `-netdev` uses. So the installer configured DHCP for this guest,
# and a stage that runs `ipadm create-addr -T dhcp $L/v4` on top of it is fighting the thing that was
# set up for it - measured, on two runs, as `host diag [icmp guest]: try1: timed out` while the guest
# was in fact booting normally behind an unreadable console.
#
# NWAM IS THE MECHANISM AND IT NEEDS TIME, NOT COMMANDS. `nwam` brings the link up and runs the DHCP
# client as part of a normal boot; the only thing this stage has to do is WAIT, and the wait it already
# has is `wait for sshd` - which cannot pass until the address exists.
#
# SO NOTHING IS CONFIGURED HERE. The console commands that tried are gone: every one of them was
# unreadable in the log (`IKON EALALADN ... WN PALL ALN`, twice with `clear` and twice without), and
# the one thing they were meant to prove - that the address exists - is exactly what ssh answers.
#
# IF SSHD STILL DOES NOT ANSWER, THE NEXT RUN'S `wait for sshd` BUDGET IS THE DIAGNOSIS: a `no route to
# host` means no address, and a `connection refused` means an address with sshd down. Those two are
# different repairs and the host already prints which one it was.
# THE ADDRESS IS CONFIGURED HERE AND PROVEN THROUGH THE SERIAL LOG, NOT THROUGH OCR.
#
# TWO MEASUREMENTS SAY NWAM ALONE IS NOT ENOUGH AND OCR CANNOT SHOW IT EITHER WAY:
#
#	run 45966722491   `host diag [ip neigh]: 172.30.0.2 dev qemubr0 FAILED`
#	                  `host diag [icmp guest]: try1: timed out`
#	                  -> NO ADDRESS AT ALL, not `connection refused`
#
#	every run         `see: 49 word(s): IKON EALALADN ... WN PALL ALN` - the console's own text
#	                  never reached the screen reader, with `clear` and without it
#
# `answers.json` IS NOT WHAT CONFIGURES THE INSTALLED SYSTEM. `admin_ip: dhcp` is the value the
# INSTALLER's headnode used while it ran; it is not a promise about the first boot of the installed
# disk, and the FAILED neighbour above is what that looks like.
#
# SO THE INTERFACE IS CONFIGURED ONCE, HERE, AND THE PROOF COMES FROM THE SERIAL LOG:
#
#	`until ... from console` reads the serial file the machine writes its console to - the same
#	channel `install.walk` uses (`until "Loading /local/answers.json" from console`), and one that
#	cannot be defeated by a screen reader that never decoded this console's characters.
#
# THE COMMAND PRINTS A LINE ONLY WHEN IT HAS SUCCEEDED, so the wait has something true to look for:
#
#	L=$(dladm show-link -p -o link | head -1); ipadm create-if $L; ipadm create-addr -T dhcp $L/v4
#	echo NET_STATIC_ADDR_OK $L
# THE SHELL'S ECHO GOES TO `/dev/term/a`, WHICH IS THE SERIAL LOG; ITS STDOUT DOES NOT.
#
# MEASURED on run 45970737494, and this is the measurement that closes the question:
#
#	=== give the interface an address
#	  typed 163 character(s)            <- THE COMMAND WAS TYPED
#	  key ret
#	=== the address exists, as the serial log reports it
#	  waiting up to 3m0s for "NET_STATIC_ADDR_OK" in console.log
#	  <- AND IT NEVER APPEARED
#
# `typed 163 character(s)` IS THE ENGINE WRITING TO THE CONSOLE, so the keystrokes arrived. What did not
# arrive is the shell's own output: on SmartOS the login shell talks to `/dev/term/b`, while the file
# this walk reads (`console.log`, the qemu `-serial` channel) carries `ttya`. The kernel writes there;
# a login shell's stdout does not.
#
# SO THE ANSWER IS SENT TO THE CHANNEL THAT IS READ, BY HAND:
#
#	{ ... } > /dev/term/a 2>&1
#
# THE SAME LINE ALSO ECHOES TO THE SHELL ITSELF, so a reader of the screen sees it too - one command,
# two channels, and the one the walk waits on is the one the machine actually writes to.
# `ipadm create-addr` RETURNS 0 AND LEAVES THE INTERFACE UNCONFIGURED WHILE NWAM OWNS IT.
#
# MEASURED on run 45974122212 - the run whose serial gate PASSED and whose ssh still could not connect:
#
#	=== the address exists, as the serial log reports it
#	  saw "NET_STATIC_ADDR_OK" (1m40s)          <- THE COMMAND RAN AND SAID IT WORKED
#	=== wait for sshd
#	  host diag [ip neigh]: 172.30.0.2 dev qemubr0 FAILED
#	  host diag [icmp guest]: try1: timed out   <- AND THERE WAS NO ADDRESS
#
# SO THE COMMAND SUCCEEDED AND THE ADDRESS DID NOT EXIST. On illumos, `ipadm` refuses to manage an
# interface that NWAM has claimed - and reports success anyway. NWAM is the default network manager
# here, so every `ipadm create-addr` this stage has run has been a no-op with a zero exit status.
#
# THE FIX IS TO TAKE THE INTERFACE AWAY FROM NWAM FIRST, WHICH IS `netadm disable`:
#
#	netadm disable -p ncu -n $L      NWAM stops managing this link
#	ipadm create-if $L               then ipadm can own it
#	ipadm create-addr -T dhcp $L/v4  and give it an address
#
# EACH LINE PRINTS ITS OWN RESULT TO /dev/term/a, so the serial log says WHICH of them failed when the
# next run does - not only that the whole thing did.
# `netadm` DOES NOT EXIST ON THIS GUEST, AND `dhcpagent` IS NOT RUNNING - BOTH MEASURED, LINE BY LINE.
#
# Run 45978333078's serial output, which the /dev/term/a redirect finally made readable:
#
#	smartos ttya login: LINK=vioif                         the interface name is right
#	-bash: netadm: command not found                        <-- THERE IS NO `netadm` HERE
#	ipadm: Could not create vioif0 : Interface already exists  the link is already there
#	ipadm: warning: Communication with dhcpagent timed out     <-- THE REAL BLOCKER
#	inet 127.0.0.1/8 ...                                     only loopback
#
# SO THREE THINGS HAD TO CHANGE, AND EACH IS NOW ITS OWN LINE IN THE SAME COMMAND:
#
#	1  `netadm` is gone from the sequence - this release does not ship it, and `svcadm` is what
#	   controls Network Auto-Magic here (`svc:/network/physical:nwam`).
#	2  `ipadm create-if` is allowed to fail: the interface exists already, and "already exists" is
#	   success for this purpose.
#	3  THE DHCP AGENT IS STARTED BEFORE THE ADDRESS IS ASKED FOR. `Communication with dhcpagent timed
#	   out` means the agent was not running, so no address could ever arrive however many times the
#	   command was retried.
#
# EVERY LINE STILL PRINTS TO /dev/term/a, so the next failure names the step that failed.
step "stop NWAM, start the DHCP agent, then ask for an address"
  input text "{ echo LINK=$(dladm show-link -p -o link | head -1); svcadm disable -s svc:/network/physical:nwam 2>&1; svcadm enable -s svc:/network/dhcp/client 2>&1 || svcadm enable -s svc:/network/dhcp-client 2>&1; ipadm create-if $(dladm show-link -p -o link | head -1) 2>&1; ipadm create-addr -T dhcp $(dladm show-link -p -o link | head -1)/v4 2>&1; sleep 5; ipadm show-addr 2>&1; } > /dev/term/a 2>&1; echo NET_STATIC_ADDR_OK"
  settle 3


step "run it"
  input ret
  settle 20


step "the address exists, as the serial log reports it"
  until "NET_STATIC_ADDR_OK"
  from console
  timeout 180


step "wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"


step "prove the account over ssh"
  ssh "id -un"


step "prove the root pool is the one that was installed"
  ssh "zpool list -H -o name,health"


step "flush the writes before the machine stops"
  ssh "sync"


step "shut the machine down"
  ssh "shutdown -i 0 -g 0 -y"


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
