# TRIBBLIX 0m41.1 OVER SSH - the administrator logs in, and the desktop is proven from outside.
#
# THIS IS THE STAGE THAT ANSWERS A QUESTION THE INSTALL LEG CANNOT: does the disk it published reach
# a shell over the NETWORK, and is there a session behind it?
#
# TRIBBLIX'S ADMINISTRATOR IS `root` AND IT IS A REAL ACCOUNT, NOT A ROLE.
#
# This is the first thing that separates Tribblix from OpenIndiana, where `root` is an RBAC role that
# cannot log in at all and the whole stage has to assume it from the installer's `vmuser`. MEASURED
# here: the live system's own `root`/`tribblix` logs in directly at the console, and `live_install.sh`
# copies `/etc/shadow` into the new boot environment as part of "copy the minimum that defines the
# system's identity". So the installed disk answers `root` with the same password the medium did.
#
# ROOT CANNOT LOG IN OVER THE NETWORK UNTIL THIS STAGE SAYS SO, AND THAT IS MEASURED, NOT ASSUMED.
#
# The first run of this stage (45640211235) waited sixty rounds for sshd and failed with
# `sshd does not accept a connection`. The frame at the end of that run explained it in one line of
# the system's own log:
#
#	tribblix sshd-session[1155]: error: PAM: Authentication failed for root from 172.30.0.1
#
# - sshd WAS up and WAS reachable, and REFUSED root's password. The reason is in the shipped config:
#
#	# grep -i permitrootlogin /etc/ssh/sshd_config
#	PermitRootLogin without-password
#
# So root may log in with a KEY and never with a password. THE CONSOLE IS WHERE THIS IS CHANGED,
# because it is the one channel that authenticates root already: log in there, set
# `PermitRootLogin yes`, restart sshd, and only then does the network accept a password.
#
# THE CONSOLE STEP IS ALSO WHY `machine_ssh` CANNOT BE WAITED ON FIRST. `stage.yml`'s own probe uses
# the same password the walk does, so the daemon's verdict is "not ready" until the config has been
# changed - waiting for it before this step would wait for the effect of a change not yet made.
walkthrough "tribblix 0m41.1 - sshd, the desktop it already has, and a shutdown"
resolution 1920x1080
recording_resolution 1920x1080
ssh_user root
var user
  default root
  from args.user
var out
  default out/tribblix-ssh.qcow2
  from args.out
password tribblix
ssh_port 2222

step "boot the installed disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


step "the console login prompt is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name login
    until
      bind up
      source login
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[tribblix, console, login]]
    max 60


# THE CONSOLE IS THE ONLY CHANNEL THAT ALREADY AUTHENTICATES root, so the config change happens here.
step "log in at the console as root"
  input text "root"
  settle 2


step "take the login name"
  input ret
  settle 6


step "type root's password"
  input text "tribblix"
  type_gap 0.1
  settle 2


step "take the password"
  input ret
  settle 10


# THE MARKER IS COMPUTED BY THE SHELL, NOT READ OFF THE PROMPT. MEASURED on the install stage's CI
# run: `root@tribblix` never matched although the prompt was plainly on screen, because `@` and
# `:/root#` are exactly what a frame read mangles. `READY-42` cannot be produced by echoing the
# command that asks for it.
step "prove the console is a root shell"
  input text "echo READY-$((6*7))"
  settle 2


step "run it"
  input ret
  settle 8


step "the shell answered with the computed value"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name shell
    until
      bind up
      source shell
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[READY-42]]
    max 40


# THE SHIPPED CONFIG SAYS `PermitRootLogin without-password`, WHICH REFUSES THE PASSWORD THIS STAGE'S
# OWN PROBE USES. The `sed` is a whole-file rewrite of that one directive rather than an append,
# because sshd takes the FIRST match it meets and an appended line after the original would lose.
#
# AND THERE IS A SECOND LOCK, IN A DIFFERENT FILE, WHICH IS WHY THE FIRST FIX ALONE WAS NOT ENOUGH.
# MEASURED on the disk this consumes, in the root shell:
#
#	# grep -E '^CONSOLE|^ROOT|^PATH' /etc/default/login
#	CONSOLE=/dev/console
#
# `CONSOLE=` is the illumos/Solaris rule that root may log in ONLY on the named device - sshd is not
# it, so root's ssh login is refused before sshd's own `PermitRootLogin` is even consulted. Clearing
# the value (`CONSOLE=`) is the documented way to lift it, and it is what the `sed` below does.
#
# BOTH ARE SET IN ONE COMMAND AND BOTH ARE READ BACK. A single `ROOTLOGIN-ON` means the `ssh`
# service is running with a config that allows a password for root AND a login file that does not
# pin root to the console - the two facts this stage's first run lacked.
step "let root log in with a password, from any terminal"
  input text "sed 's/^PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config > /etc/ssh/sshd_config.new && mv /etc/ssh/sshd_config.new /etc/ssh/sshd_config; sed 's|^CONSOLE=.*|CONSOLE=|' /etc/default/login > /etc/default/login.new && mv /etc/default/login.new /etc/default/login; grep -q '^PermitRootLogin yes' /etc/ssh/sshd_config && grep -q '^CONSOLE=$' /etc/default/login && echo ROOTLOGIN-ON || echo ROOTLOGIN-OFF"
  type_gap 0.02
  settle 3


step "run it"
  input ret
  settle 10


# THE WITNESS IS A WORD THE SHELL CHOOSES, NOT THE DIRECTIVE'S TEXT.
#
# The `grep -q` above answers only in exit status, and the command line printed on screen ends in
# `echo ROOTLOGIN-ON || echo ROOTLOGIN-OFF` - so neither word appears in it. `ROOTLOGIN-ON` on screen
# therefore means the test passed: the file now carries exactly the directive sshd needs to accept
# root's password.
step "the directive is in place"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name count
    until
      bind up
      source count
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[ROOTLOGIN-ON]]
      without [ROOTLOGIN-OFF]
    max 40


step "restart sshd so the new directive is read"
  input text "svcadm restart ssh; svcs -H -o state ssh"
  settle 3


step "run it"
  input ret
  settle 12


# NOW, AND ONLY NOW, DOES THE DAEMON'S OWN PROBE HAVE A CHANCE: sshd has been restarted with root's
# password login allowed, so `machine_ssh` is the right thing to wait on.
step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un"
  timeout 120


step "prove the root pool is the one that was installed"
  ssh "zpool list -H -o name,size rpool"
  timeout 120


step "prove the desktop overlay is on the disk"
  ssh "ls /usr/share/xsessions"
  timeout 120


# THE DESKTOP IS ALREADY INSTALLED, AND THAT IS THE DIFFERENCE FROM OPENINDIANA.
#
# The install stage ran `live_install.sh -G c1t0d0 desktop`, which installs the Xfce overlay FROM THE
# MEDIUM - no network, no `pkg` run, no ninety-minute step. MEASURED: `/usr/share/xsessions` on a disk
# this install produced holds `xfce.desktop`, and the session's display manager is `slim`, which the
# smoke stage's own boot showed starting `svc:/system/slim:default`.
step "enable the display manager"
  ssh "svcadm enable -r svc:/system/slim:default; echo DM_EXIT=$?"
  timeout 300


step "the display manager reports online"
  ssh "svcs -H -o state svc:/system/slim:default"
  timeout 300


# THE SAME PICTURE GATE THE REST OF THIS REPOSITORY USES. A display manager that is online and a
# session on screen are two different facts, and only the frame can tell them apart.
step "the desktop is on screen"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name screen
    until
      bind desktop
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [["Applications"]]
    max 90


step "flush the writes before anything else"
  ssh "sync"
  timeout 300


step "flush the writes before the machine stops"
  ssh "sync"
  timeout 300


# `stop ssh` RATHER THAN `stop power`: an ACPI power press asks the desktop to shut down, and a
# desktop that is still bringing itself up may ignore it for the whole timeout.
step "shut the machine down"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
  save "{{ out }}"
